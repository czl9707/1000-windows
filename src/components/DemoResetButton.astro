---
import Button from '@/components/ui/Button.astro';
import { ResetIcon } from '@radix-ui/react-icons';
---

<Button variant="filled" color="transparent" data-demo-reset aria-label="Reset tuning">
    <ResetIcon />
</Button>

<script>
    // The reset button restores whatever demo is mounted in its enclosing
    // frame to its default parameters through its handle.
    import { handleRegistered, tuningHandleFor } from './mount';

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-demo-reset]')) {
        const canvas = button.closest('[data-demo-frame]')?.querySelector('canvas[data-demo]');
        if (!(canvas instanceof HTMLCanvasElement)) {
            throw new Error('reset button: no demo canvas in the enclosing frame');
        }
        button.addEventListener('click', () => {
            handleRegistered(canvas).then(() => {
                tuningHandleFor(canvas).resetParams();
            });
        });
    }
</script>
