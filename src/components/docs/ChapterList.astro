---
import Typography from '@/components/ui/Typography.astro';
import NavBox from './NavBox.astro';
import NavRow from './NavRow.astro';
import type { ChapterItem } from './types';

interface Props {
  chapters: ChapterItem[];
  chapter: ChapterItem;
}

const { chapters, chapter } = Astro.props;
---

<NavBox label="Chapters">
  {
    chapters.map((c) => (
      <NavRow href={`/docs/${c.slug}`} active={c.slug === chapter.slug}>
        <span class="Row">
          <span class="Num">{String(c.number).padStart(2, "0")}</span>
          <Typography as="span" variant="body1">{c.title}</Typography>
        </span>
      </NavRow>
    ))
  }
</NavBox>

<style>
  .Row {
    display: flex;
    align-items: baseline;
    gap: calc(var(--spacing-paragraph) / 2);
  }

  .Num {
    font-family: var(--typography-code-fontFamily);
    font-weight: var(--typography-code-fontWeight);
    font-size: var(--typography-code-fontSize);
    line-height: var(--typography-code-lineHeight);
    color: rgb(var(--color-accent-foreground));
  }
</style>
