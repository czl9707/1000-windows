---
import Button from '@/components/ui/Button.astro';
import { ShuffleIcon } from '@radix-ui/react-icons';
---

<Button variant="filled" color="transparent" data-demo-reseed aria-label="Reseed demo">
    <ShuffleIcon />
</Button>

<script>
    // The reseed button talks to whatever demo is mounted in its enclosing
    // frame: it re-rolls that demo's seed parameter through its handle.
    import { handleRegistered, tuningHandleFor } from './mount';

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-demo-reseed]')) {
        const canvas = button.closest('[data-demo-frame]')?.querySelector('canvas[data-demo]');
        if (!(canvas instanceof HTMLCanvasElement)) {
            throw new Error('reseed button: no demo canvas in the enclosing frame');
        }
        button.addEventListener('click', () => {
            handleRegistered(canvas).then(() => {
                tuningHandleFor(canvas).reseed(Math.floor(Math.random() * 100000));
            });
        });
    }
</script>
