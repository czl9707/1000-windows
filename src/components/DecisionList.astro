---
import { decisions } from '../data/decisions';
import styles from './DecisionList.module.css';
---

<ul class={styles.list}>
  {
    decisions.map((entry) => (
      <li class={styles.entry}>
        <h3 class={styles.title}>{entry.title}</h3>
        <p class={styles.meta}>
          <time datetime={entry.date}>{entry.date}</time> · <code>{entry.ticket}</code>
        </p>
        <p class={styles.gist}>{entry.gist}</p>
      </li>
    ))
  }
</ul>
