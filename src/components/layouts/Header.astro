---
import Section from "@/components/ui/Section.astro";
import ThemeToggle from "@/components/layouts/ThemeToggle.astro";
import Button from "@/components/ui/Button.astro";
import { ShuffleIcon } from "@radix-ui/react-icons";

interface Props {
  siteTitle: string;
}

const { siteTitle } = Astro.props;
// The shuffle belongs to the wall; the wall is the home page's canvas.
const isHome = Astro.url.pathname === "/";
// The lockup's path data is pre-generated once with the project's seeded pen
// (the tremor generators behind the wall); it is static ink here, themed
// through currentColor and the accent token.
