---
import Section from "@/components/ui/Section.astro";
import Typography from "@/components/ui/Typography.astro";
import ThemeToggle from "@/components/layouts/ThemeToggle.astro";

interface Props {
  siteTitle: string;
}

const { siteTitle } = Astro.props;
---

<Section class:list={"HeaderContainer"}>
    <a href={"/"}>
        <Typography variant="h5" style={{ cursor: "pointer", fontWeight: 800 }}>
            {siteTitle}
        </Typography>
    </a>

    <div style={{ flex: "1 1" }}></div>

    <ThemeToggle />
</Section>

<style>
    @keyframes SlideDown {
        from {
            transform: translateY(-100%);
        }
        to {
            transform: none;
        }
    }

    .HeaderContainer {
        position: fixed;
        top: 0;
        height: var(--size-header-height);
        z-index: 50;
        width: 100vw;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: var(--spacing-paragraph);
        animation: SlideDown var(--transition-long)
            cubic-bezier(0.75, 0, 0.25, 1) forwards;
        background-image: linear-gradient(to bottom, rgb(var(--color-primary-background)) 10%, transparent);
    }
</style>
