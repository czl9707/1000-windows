---
import Section from "@/components/ui/Section.astro";
import Typography from "@/components/ui/Typography.astro";
import ThemeToggle from "@/components/layouts/ThemeToggle.astro";
import Button from "@/components/ui/Button.astro";
import { ShuffleIcon } from "@radix-ui/react-icons";

interface Props {
  siteTitle: string;
}

const { siteTitle } = Astro.props;
// The shuffle belongs to the wall; the wall is the home page's canvas.
const isHome = Astro.url.pathname === "/";
---

<Section class:list={"HeaderContainer"}>
    <a href={"/"}>
        <Typography variant="h5" style={{ cursor: "pointer", fontWeight: 800 }}>
            {siteTitle}
        </Typography>
    </a>

    <div style={{ flex: "1 1" }}></div>

    <Button variant="filled" color="transparent" as="a" href="/docs/">
        Docs
    </Button>
    {isHome && (
        <Button variant="filled" color="transparent" id="wall-shuffle" aria-label="Shuffle the wall">
            <ShuffleIcon />
        </Button>
    )}
    <ThemeToggle />
</Section>

<script>
    import { handleRegistered, reseedHandleFor, rollSeed } from "@/components/mount";

    document.getElementById("wall-shuffle")?.addEventListener("click", () => {
        const canvas = document.querySelector('canvas[data-demo="wall"]');
        if (!(canvas instanceof HTMLCanvasElement)) {
            throw new Error("shuffle: no wall canvas on the page");
        }
        handleRegistered(canvas).then(() => {
            reseedHandleFor(canvas)!.reseed(rollSeed());
        });
    });
</script>

<style>
    @keyframes SlideDown {
        from {
            transform: translateY(-100%);
        }
        to {
            transform: none;
        }
    }

    .HeaderContainer {
        position: fixed;
        top: 0;
        height: var(--size-header-height);
        z-index: 50;
        width: 100vw;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: var(--spacing-paragraph);
        animation: SlideDown var(--transition-long)
            cubic-bezier(0.75, 0, 0.25, 1) forwards;
        background-image: linear-gradient(to bottom, rgb(var(--color-primary-background)) 10%, transparent);
    }
</style>
