---
import "@/styles/global.css";
import '@fontsource-variable/red-hat-mono';
import '@fontsource-variable/geist';

import Header from "@/components/layouts/Header.astro";
import { SITE_TITLE } from "@/lib/utils/constants";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: {
    title?: string;
  };
  wide?: boolean;
}

const { title, description, frontmatter, wide = false } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? SITE_TITLE;
const fullTitle =
  pageTitle === SITE_TITLE ? SITE_TITLE : `${pageTitle} — ${SITE_TITLE}`;
const descriptionText =
  description ??
  'An infinite hand-drawn wall of windows, built in the open — every chapter quoting the real code behind it, with the living demo embedded.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={descriptionText} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <script is:inline>
      const theme = localStorage.getItem("theme") || "dark";
      document.body.setAttribute("data-theme", theme);
    </script>
    <Header siteTitle={SITE_TITLE} />
    <main class:list={{ Wide: wide }}>
      <slot />
    </main>
  </body>
</html>

<style>
  main {
    max-width: var(--size-prose-max);
    margin: 0 auto;
    padding: calc(var(--size-header-height) + 1.5rem) 1.25rem 4rem;
    min-height: 100vh;
    box-sizing: border-box;
    isolation: isolate;
  }

  main.Wide {
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }

  body {
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
    margin: 0;
    overflow-x: visible;
    position: relative;
    background-color: rgb(var(--color-primary-background));
    color: rgb(var(--color-primary-foreground));
  }

  html {
    scroll-behavior: smooth;
    :target {
      scroll-margin-top: calc(var(--size-header-height) + var(--spacing-group));
    }
  }
</style>
