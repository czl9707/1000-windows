---
import Button from '@/components/ui/Button.astro';
import BaseLayout from '@/components/layouts/BaseLayout.astro';
---

<BaseLayout>
  <canvas
    data-demo="wall"
    class="Wall"
    aria-label="The wall — an endless hand-drawn wall of windows; drag to pan, use the shuffle button for a new wall"
    role="img"
  ></canvas>
  <div class="FocusNav" data-focus-nav hidden>
    <Button variant="filled" color="transparent" data-focus-prev aria-label="Focus the window to the left">←</Button>
    <span class="FocusSeed" data-focus-seed></span>
    <Button variant="filled" color="transparent" data-focus-next aria-label="Focus the window to the right">→</Button>
  </div>
</BaseLayout>

<style>
  .Wall {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }

  .Wall:active {
    cursor: grabbing;
  }

  .FocusNav {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .FocusNav[hidden] {
    display: none;
  }

  .FocusSeed {
    padding: 0.4rem 0.75rem;
    border-radius: var(--size-border-radius);
    background: rgb(var(--color-primary-background) / 0.72);
    color: rgb(var(--color-primary-foreground));
    font-family: var(--typography-button-fontFamily);
    font-size: var(--typography-button-fontSize);
    font-weight: var(--typography-button-fontWeight);
    line-height: var(--typography-button-lineHeight);
    user-select: none;
  }
</style>

<script>
  // The home wall's painter lives here, beside its one consumer; the page
  // mounts it through the demo runtime, so the shuffle's canvas lookup
  // reaches the handle.
  import { createDemoLoop, cssBox } from '@/components/demoLoop';
  import { mount, registerDemo, rollSeed, type ReseedHandle } from '@/components/mount';
  import { PITCH_X, PITCH_Y, WINDOW_SCALE, visibleCells, wallUnits, dragWall, Wall } from '@/core/wall';
  import { BOX } from '@/core/window-shell/shell';
  import { windowSeed } from '@/core/randomness/rng';
  import { drawWindow, lampLit } from '@/core/window';
  import { windowPalette } from '@/styling/colourway';
  import { Pen } from '@/pen/pen';
  import { DEFAULT_TUNING } from '@/pen/tuning';

  // At least one full cell, so a window's pen is warm before its box scrolls in.
  const MARGIN = Math.max(PITCH_X, PITCH_Y);

  // The focus state is the page's own: a tapped window rides to the screen
  // centre at FOCUS_SCALE times its wall size while everything else stops
  // being drawn, any click hands the wall back, and the arrow buttons (or
  // arrow keys) slide the focus along the row — the strip position eases
  // toward the target column so neighbouring windows hand off mid-slide.
  const FOCUS_SCALE = 1.6;
  const FOCUS_SECONDS = 0.45;
  const FOCUS_SLIDE_RATE = 10;
  const TAP_THRESHOLD_PX = 5;
  const easeOutCubic = (t: number): number => 1 - Math.pow(1 - t, 3);

  interface FocusState {
    anchorCol: number;
    row: number;
    strip: number;
    target: number;
    t: number;
    releasing: boolean;
  }

  function mountWall(canvas: HTMLCanvasElement): ReseedHandle {
    let metaSeed = rollSeed();
    const wall = new Wall(metaSeed);

    const pxPerUnit = () => {
      const box = cssBox(canvas);
      return wallUnits(box.width, box.height);
    };
    // The pan gestures come and go with the focus: a focused wall holds
    // still, and the binding returns once the window has landed back.
    let unbindGestures = dragWall(wall, canvas, pxPerUnit);
    const rebindGestures = () => {
      unbindGestures();
      unbindGestures = dragWall(wall, canvas, pxPerUnit);
    };

    // The focused tenant draws through its own pen — the wall's ledger is
    // its private state — keyed by cell and re-seeded with the wall.
    const focusPens = new Map<string, Pen>();
    const focusPen = (col: number, row: number): Pen => {
      const key = `${col},${row}`;
      let pen = focusPens.get(key);
      if (!pen) {
        pen = new Pen({ ...DEFAULT_TUNING }, windowSeed(metaSeed, col, row));
        focusPens.set(key, pen);
      }
      return pen;
    };

    // The cell whose drawn box holds the pointer, in client pixels. Null
    // when the pointer stands on bare wall.
    const cellAt = (px: number, py: number, unit: number): { col: number; row: number } | null => {
      const wx = wall.camera.x + (px - canvas.clientWidth / 2) / unit;
      const wy = wall.camera.y + (py - canvas.clientHeight / 2) / unit;
      const col = Math.round(wx / PITCH_X);
      const row = Math.round(wy / PITCH_Y);
      return Math.abs(wx - col * PITCH_X) <= BOX.halfW * WINDOW_SCALE &&
        Math.abs(wy - row * PITCH_Y) <= BOX.halfH * WINDOW_SCALE
        ? { col, row }
        : null;
    };

    let focus: FocusState | null = null;
    const enterFocus = (col: number, row: number) => {
      focus = { anchorCol: col, row, strip: col, target: col, t: 0, releasing: false };
      wall.velocity = { x: 0, y: 0 };
      unbindGestures();
    };
    const leaveFocus = () => {
      if (focus) focus.releasing = true;
    };
    const shiftFocus = (dir: number) => {
      if (!focus || focus.releasing) return;
      focus.target += dir;
    };

    // The arrow buttons and the seed readout live in the bar under the
    // focused window; the page shows the bar only while the focus holds.
    const nav = document.querySelector<HTMLElement>('[data-focus-nav]');
    const prevButton = nav?.querySelector<HTMLButtonElement>('[data-focus-prev]');
    const nextButton = nav?.querySelector<HTMLButtonElement>('[data-focus-next]');
    const seedLabel = nav?.querySelector<HTMLElement>('[data-focus-seed]');
    const onPrev = () => shiftFocus(-1);
    const onNext = () => shiftFocus(1);
    prevButton?.addEventListener('click', onPrev);
    nextButton?.addEventListener('click', onNext);
    let navShown = false;
    let seedShown = '';

    // The cursor, normalized to the viewport and eased per frame — the raw
    // position reads twitchy at full-screen scale.
    const pointer = { x: 0, y: 0 };
    const eased = { x: 0, y: 0 };
    const onMove = (e: PointerEvent) => {
      pointer.x = e.clientX / window.innerWidth - 0.5;
      pointer.y = e.clientY / window.innerHeight - 0.5;
      const unit = pxPerUnit();
      canvas.style.cursor =
        focus || cellAt(e.clientX, e.clientY, unit) ? 'pointer' : 'grab';
    };
    const onLeave = () => {
      pointer.x = 0;
      pointer.y = 0;
    };
    window.addEventListener('pointermove', onMove);
    document.documentElement.addEventListener('mouseleave', onLeave);

    // Taps drive the focus; drags belong to the wall's own gestures. A tap
    // on a window lifts it out; once focused, any tap hands the wall back.
    let tapStart: { x: number; y: number } | null = null;
    let tapDistance = 0;
    const onTapDown = (e: PointerEvent) => {
      tapStart = { x: e.clientX, y: e.clientY };
      tapDistance = 0;
    };
    const onTapMove = (e: PointerEvent) => {
      if (!tapStart) return;
      tapDistance += Math.hypot(e.clientX - tapStart.x, e.clientY - tapStart.y);
    };
    const onTapUp = (e: PointerEvent) => {
      const wasTap = tapStart !== null && tapDistance < TAP_THRESHOLD_PX;
      tapStart = null;
      if (!wasTap) return;
      if (focus) {
        leaveFocus();
        return;
      }
      const unit = pxPerUnit();
      const cell = cellAt(e.clientX, e.clientY, unit);
      if (cell) enterFocus(cell.col, cell.row);
    };
    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') leaveFocus();
      if (focus && !focus.releasing) {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          shiftFocus(-1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          shiftFocus(1);
        }
      }
    };
    canvas.addEventListener('pointerdown', onTapDown);
    canvas.addEventListener('pointermove', onTapMove);
    canvas.addEventListener('pointerup', onTapUp);
    window.addEventListener('keydown', onKeyDown);

    let lastFrameTime = 0;
    const loop = createDemoLoop(
      canvas,
      (ctx, time, theme, base) => {
        const box = cssBox(canvas);
        const dt = Math.min(Math.max(time - lastFrameTime, 0), 0.1);
        lastFrameTime = time;
        wall.advance(dt);
        if (focus) {
          const step = dt / FOCUS_SECONDS;
          focus.t = focus.releasing ? Math.max(focus.t - step, 0) : Math.min(focus.t + step, 1);
          const drift = focus.target - focus.strip;
          if (drift !== 0) {
            focus.strip += drift * (1 - Math.exp(-dt * FOCUS_SLIDE_RATE));
            if (Math.abs(focus.target - focus.strip) < 0.001) focus.strip = focus.target;
          }
          const showNav = !focus.releasing;
          if (nav && navShown !== showNav) {
            nav.hidden = !showNav;
            navShown = showNav;
          }
          if (seedLabel && showNav) {
            const key = `${focus.target},${focus.row}`;
            if (seedShown !== key) {
              seedLabel.textContent = `Seed: ${focusPen(focus.target, focus.row).seed}`;
              seedShown = key;
            }
          }
          if (focus.releasing && focus.t === 0) {
            focus = null;
            rebindGestures();
          }
        }
        const unit = wallUnits(box.width, box.height);
        const cells = visibleCells(wall.camera, box.width / unit, box.height / unit, MARGIN);
        const follow = 1 - Math.exp(-dt * 8);
        eased.x += (pointer.x - eased.x) * follow;
        eased.y += (pointer.y - eased.y) * follow;
        // The focal point rides opposite the cursor: the projection's fixed
        // screen point sits at centre − eye·unit, so the cursor's full
        // offset as the eye parks it at the cursor's mirror through the
        // centre — the wall leans toward the pointer, and leaving the
        // viewport re-centres everything.
        const cx = (eased.x * box.width) / unit;
        const cy = (eased.y * box.height) / unit;
        const eye = { x: base.x + cx, y: base.y + cy };
        if (!focus) {
          wall.draw(ctx, box, { unit, eye, cells, margin: MARGIN }, time, theme);
          return;
        }
        // While the focus rides, the wall still paints underneath so it can
        // fade — then the focused frame is this window alone, everything
        // else simply is not drawn.
        const k = easeOutCubic(focus.t);
        if (k < 1) {
          wall.draw(ctx, box, { unit, eye, cells, margin: MARGIN }, time, theme);
          ctx.save();
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.globalAlpha = 1 - k;
          ctx.globalCompositeOperation = 'destination-in';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.restore();
        }
        const active = focus;
        const anchorX = active.anchorCol * PITCH_X;
        const anchorY = active.row * PITCH_Y;
        const x = anchorX + (wall.camera.x - anchorX) * k;
        const y = anchorY + (wall.camera.y - anchorY) * k;
        const s = WINDOW_SCALE * (1 + (FOCUS_SCALE - 1) * k);
        // One shift travels the whole viewport: the incoming window starts
        // past the screen edge, the one it replaces leaves past the other.
        const spacing = box.width / unit + 2 * BOX.halfW * s;
        const drawFocused = (col: number) => {
          const wx = x + (col - active.strip) * spacing;
          const pen = focusPen(col, active.row);
          pen.setTime(time);
          ctx.save();
          ctx.scale(box.dpr * unit, box.dpr * unit);
          ctx.translate(
            box.width / (2 * unit) - wall.camera.x,
            box.height / (2 * unit) - wall.camera.y,
          );
          ctx.translate(wx, y);
          ctx.scale(s, s);
          drawWindow(ctx, pen, windowPalette(pen.seed, theme, lampLit(pen.seed)), {
            x: eye.x + wx - wall.camera.x,
            y: eye.y + y - wall.camera.y,
          }, theme.night);
          ctx.restore();
        };
        const first = Math.floor(active.strip);
        const last = Math.ceil(active.strip);
        drawFocused(first);
        if (last !== first) drawFocused(last);
      },
      // The wall's real eye: where this canvas sits relative to the screen's
      // centre, in unit measure. Filling the viewport, it sits at the centre;
      // the resolver keeps the term honest whatever the layout does.
      (cv) => {
        const rect = cv.getBoundingClientRect();
        const unit = wallUnits(rect.width, rect.height);
        return {
          x: (rect.left + rect.width / 2 - window.innerWidth / 2) / unit,
          y: (rect.top + rect.height / 2 - window.innerHeight / 2) / unit,
        };
      },
    );

    return {
      reseed(value) {
        metaSeed = value;
        wall.reseed(value);
        focusPens.clear();
        loop.repaint();
        loop.notify();
      },
      destroy() {
        unbindGestures();
        window.removeEventListener('pointermove', onMove);
        document.documentElement.removeEventListener('mouseleave', onLeave);
        canvas.removeEventListener('pointerdown', onTapDown);
        canvas.removeEventListener('pointermove', onTapMove);
        canvas.removeEventListener('pointerup', onTapUp);
        window.removeEventListener('keydown', onKeyDown);
        prevButton?.removeEventListener('click', onPrev);
        nextButton?.removeEventListener('click', onNext);
        loop.destroy();
      },
    };
  }

  registerDemo('wall', mountWall);
  mount(document.querySelector<HTMLCanvasElement>('canvas[data-demo="wall"]')!);
</script>
