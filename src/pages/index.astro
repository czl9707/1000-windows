---
import BaseLayout from '@/components/layouts/BaseLayout.astro';
---

<BaseLayout>
  <canvas
    data-demo="wall"
    class="Wall"
    aria-label="The wall — an endless hand-drawn wall of windows; drag to pan, use the shuffle button for a new wall"
    role="img"
  ></canvas>
</BaseLayout>

<style>
  .Wall {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }

  .Wall:active {
    cursor: grabbing;
  }
</style>

<script>
  // The home wall's painter lives here, beside its one consumer; the page
  // mounts it through the demo runtime, so the shuffle's canvas lookup
  // reaches the handle.
  import { createDemoLoop, cssBox } from '@/components/demoLoop';
  import { mount, registerDemo, rollSeed, type ReseedHandle } from '@/components/mount';
  import { PITCH_X, PITCH_Y, visibleCells, wallUnits, dragWall, Wall } from '@/core/wall';

  // At least one full cell, so a window's pen is warm before its box scrolls in.
  const MARGIN = Math.max(PITCH_X, PITCH_Y);

  function mountWall(canvas: HTMLCanvasElement): ReseedHandle {
    const wall = new Wall(rollSeed());

    const pxPerUnit = () => {
      const box = cssBox(canvas);
      return wallUnits(box.width, box.height);
    };
    const unbindGestures = dragWall(wall, canvas, pxPerUnit);

    let lastFrameTime = 0;
    const loop = createDemoLoop(
      canvas,
      (ctx, time, theme, eye) => {
        const box = cssBox(canvas);
        const dt = Math.min(Math.max(time - lastFrameTime, 0), 0.1);
        lastFrameTime = time;
        wall.advance(dt);
        const unit = wallUnits(box.width, box.height);
        const cells = visibleCells(wall.camera, box.width / unit, box.height / unit, MARGIN);
        wall.draw(ctx, box, { unit, eye, cells, margin: MARGIN }, time, theme);
      },
      // The wall's real eye: where this canvas sits relative to the screen's
      // centre, in unit measure. Filling the viewport, it sits at the centre;
      // the resolver keeps the term honest whatever the layout does.
      (cv) => {
        const rect = cv.getBoundingClientRect();
        const unit = wallUnits(rect.width, rect.height);
        return {
          x: (rect.left + rect.width / 2 - window.innerWidth / 2) / unit,
          y: (rect.top + rect.height / 2 - window.innerHeight / 2) / unit,
        };
      },
    );

    return {
      reseed(value) {
        wall.reseed(value);
        loop.repaint();
        loop.notify();
      },
      destroy() {
        unbindGestures();
        loop.destroy();
      },
    };
  }

  registerDemo('wall', mountWall);
  mount(document.querySelector<HTMLCanvasElement>('canvas[data-demo="wall"]')!);
</script>
