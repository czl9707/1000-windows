---
import BaseLayout from '@/components/layouts/BaseLayout.astro';
---

<BaseLayout title="Humaaans seated preview">
  <main>
    <h1>Humaaans — seated tenant preview</h1>
    <p>
      Prototype, throwaway. One style, three plates: the Humaaans tenant
      (Pablo Stanley's modular vector people) seated on a plain chair block —
      capsule limbs with rounded overlaps instead of drawn joints, flat
      clothing blocks, no face at all, hair as one flat mass. The chair is a
      slab in a furniture role; the coat stand stays pinned opposite the lamp
      as the size anchor. Daylight pinned; the button re-rolls in place.
    </p>

    <section>
      <canvas id="row" width="1500" height="620"></canvas>
      <button id="row-reseed" type="button">New sheet</button>
      <span id="row-seed"></span>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }
  canvas {
    width: 100%;
    height: auto;
    display: block;
    border: var(--border);
  }
  section {
    margin-bottom: 2rem;
  }
</style>

<script>
  // PROTOTYPE, throwaway: the Humaaans tenant drawn as marks into a real
  // window scene, three plates for per-window variety.
  import { createDemoLoop, cssBox } from '@/components/demoLoop';
  import { Pen } from '@/pen/pen';
  import { DEFAULT_TUNING } from '@/pen/tuning';
  import { rollSeed } from '@/components/mount';
  import type { Theme, ColorRole } from '@/styling/roles';
  import { windowPalette } from '@/styling/colourway';
  import { fork, windowSeed } from '@/core/randomness/rng';
  import { execute, type Mark } from '@/core/scene';
  import { shellMarks, expandShell } from '@/core/window-shell';
  import { innerRect, type PaneRect } from '@/core/window-shell/shell';
  import { sillMarks } from '@/core/sill';
  import { pinnedLamp } from '@/core/light/light';
  import { lampMarks } from '@/core/light/drawLamp';
  import { roomOf } from '@/core/furniture/room';
  import { drawFurniture } from '@/core/furniture/drawFurniture';
  import { makeProjection } from '@/motion/projection';
  import type { Pt3 } from '@/motion/projection';

  const UNIT_PITCH_X = 2.3;
  const UNIT_PITCH_Y = 1.8;
  const PLATES = 3;

  document.body.setAttribute('data-theme', 'light');

  const TENANT_DEPTH = -0.15;
  const TENANT_Z = -8.8;
  const atT = () => TENANT_DEPTH;
  const zT = () => TENANT_Z;

  interface Spot {
    x0: number;
    x1: number;
    floorY: number;
    topY: number;
    w: number;
    h: number;
  }

  const mass = (role: ColorRole, pts: Pt3[]): Mark => ({ kind: 'fill', pts, role, z: zT() });

  interface Variant {
    facing: 1 | -1;
    lean: number;
    topRole: ColorRole;
    legRole: ColorRole;
    hairKind: 'bob' | 'pony' | 'crop';
    armKind: 'lap' | 'down';
    thighLift: number;
  }

  function rollVariant(seed: number, i: number, lampRight: boolean): Variant {
    const r = fork(windowSeed(seed, i, 0), 'humaaans-tenant');
    const topRole = r.weighted([
      { value: 'lamp' as const, weight: 3 },
      { value: 'fabric' as const, weight: 2 },
      { value: 'shade' as const, weight: 1 },
    ]);
    // The trouser block never repeats the top block: adjacent flat fields
    // need a colour boundary or the leg merges into the torso.
    const legPool = (['ink', 'furniture5', 'box'] as const).filter((c) => c !== topRole);
    return {
      facing: lampRight ? 1 : -1,
      lean: r.float(-0.03, 0.03),
      topRole,
      legRole: legPool[Math.floor(r.float(0, legPool.length))],
      hairKind: r.weighted([
        { value: 'bob' as const, weight: 3 },
        { value: 'pony' as const, weight: 2 },
        { value: 'crop' as const, weight: 1 },
      ]),
      armKind: r.weighted([
        { value: 'lap' as const, weight: 2 },
        { value: 'down' as const, weight: 1 },
      ]),
      thighLift: r.float(-0.1, 0.6),
    };
  }

  const TENANT_W = 0.58;
  const TENANT_H = 1.4;
  // Seat height sets what survives the sightline at floor - 0.85: the hip
  // must sit above it or the whole leg construction crops away.
  const SEAT_H = 0.94;
  const HEAD_R = 0.06;

  // The figure is built in head-radius measures around the hip centre (the
  // seat top); every x offset flips with the facing so the seated view
  // turns toward the lamp. dy is up from the hip, in head radii.
  function humaaansTenant(s: Spot, v: Variant): Mark[] {
    const marks: Mark[] = [];
    const cx = (s.x0 + s.x1) / 2 + v.lean;
    const hx = cx;
    const hy = s.floorY - SEAT_H;
    const f = v.facing;
    const r = HEAD_R;
    const P = (dx: number, dy: number): Pt3 => ({ x: hx + f * dx * r, y: hy - dy * r, z: atT() });

    // A stadium outline: two offset sides plus rounded caps, sampled so the
    // Pen carries it as one closed field — the Humaaans capsule module.
    const capsule = (x0: number, y0: number, x1: number, y1: number, w: number, n = 10): Pt3[] => {
      const theta = Math.atan2(y1 - y0, x1 - x0);
      const px = -Math.sin(theta) * w;
      const py = Math.cos(theta) * w;
      const pts: Pt3[] = [];
      for (let k = 0; k <= n; k++) {
        const t = k / n;
        pts.push(P(x0 + (x1 - x0) * t + px, y0 + (y1 - y0) * t + py));
      }
      for (let k = 1; k < n; k++) {
        const a = theta + Math.PI / 2 - (Math.PI * k) / n;
        pts.push(P(x1 + Math.cos(a) * w, y1 + Math.sin(a) * w));
      }
      for (let k = 0; k <= n; k++) {
        const t = 1 - k / n;
        pts.push(P(x0 + (x1 - x0) * t - px, y0 + (y1 - y0) * t - py));
      }
      for (let k = 1; k < n; k++) {
        const a = theta - Math.PI / 2 - (Math.PI * k) / n;
        pts.push(P(x0 + Math.cos(a) * w, y0 + Math.sin(a) * w));
      }
      return pts;
    };
    const slab = (xa: number, ya: number, xb: number, yb: number): Pt3[] => [
      P(xa, ya),
      P(xb, ya),
      P(xb, yb),
      P(xa, yb),
    ];
    const ellipse = (ex: number, ey: number, rx: number, ry: number, n = 18): Pt3[] =>
      Array.from({ length: n }, (_, k) => {
        const a = (k / n) * Math.PI * 2;
        return P(ex + Math.cos(a) * rx, ey + Math.sin(a) * ry);
      });

    // Stool: seat slab, a back rest in its own furniture role tall enough
    // to clear the shoulder so it reads behind the torso, and legs down to
    // the floor. Drawn first, the figure sits over it; the sightline crops
    // the legs' lower run like it crops the shin.
    marks.push(mass('furniture2', slab(-3.4, 0.4, -1.0, 7.4)));
    marks.push(mass('furniture3', slab(-2.2, -1.2, 4.6, 0.5)));
    marks.push(mass('furniture3', slab(-2.0, -16.5, -1.2, -1.2)));
    marks.push(mass('furniture3', slab(3.4, -16.5, 4.2, -1.2)));

    // Thigh capsule, horizontal off the hip with a slight lift, its
    // underside resting on the seat; its round far end is the knee.
    marks.push(mass(v.legRole, capsule(0.4, 1.5, 3.5, 1.7 + v.thighLift, 1.0)));

    // Shin capsule, vertical from inside the knee down past the sightline;
    // no knee or ankle drawn — the capsule ends are the joints.
    marks.push(mass(v.legRole, capsule(3.6, 1.2, 3.95, -15.5, 0.8)));

    // Torso capsule, upright: its rounded bottom laps over the thigh as the
    // hip joint, its top ends below the head so no neck is drawn.
    marks.push(mass(v.topRole, capsule(0.15, 1.1, 0.4, 4.6, 1.5)));

    // One arm capsule — sleeve in the top colour, ending on the thigh or
    // hanging; the small rounded hand tip in skin is the capsule's own cap.
    if (v.armKind === 'lap') {
      marks.push(mass(v.topRole, capsule(0.9, 5.2, 2.9, 2.2, 0.6)));
      marks.push(mass('light', capsule(2.9, 2.2, 3.1, 1.9, 0.42, 8)));
    } else {
      marks.push(mass(v.topRole, capsule(0.9, 5.2, 1.1, 1.4, 0.6)));
      marks.push(mass('light', capsule(1.1, 1.4, 1.15, 0.6, 0.42, 8)));
    }

    // Head: a bare skin field, no face at all, sitting directly on the
    // torso's rounded shoulder cap; the hair mass covers crown and back.
    marks.push(mass('light', ellipse(0.55, 6.5, 0.95, 1.05)));

    // Hair: one flat ink mass over the crown and back of the head, the
    // forehead and jaw left as skin. Bob drops a side mass past the jaw;
    // pony trails one capsule back off the nape; crop is the dome alone.
    marks.push(mass('ink', ellipse(-0.05, 6.9, 1.0, 0.78)));
    if (v.hairKind === 'bob') {
      marks.push(mass('ink', capsule(-0.75, 6.7, -0.95, 5.6, 0.42)));
    } else if (v.hairKind === 'pony') {
      marks.push(mass('ink', capsule(-0.8, 6.9, -1.85, 6.2, 0.48)));
    }

    return marks;
  }

  // ?plate=<0..2> collapses the row to one huge plate — the close look
  // without a screenshot slicer.
  const only = new URLSearchParams(window.location.search).get('plate');
  const onlyN = only === null ? NaN : Number(only);
  const shown: number[] =
    Number.isInteger(onlyN) && onlyN >= 0 && onlyN < PLATES ? [onlyN] : [0, 1, 2];

  function fit(box: { width: number; height: number; dpr: number }) {
    const cols = shown.length;
    const scale = Math.min(box.width / (cols * UNIT_PITCH_X), box.height / UNIT_PITCH_Y);
    return { scale: box.dpr * scale, cx: (box.width * box.dpr) / 2, cy: (box.height * box.dpr) / 2 };
  }

  function plateOrigin(g: ReturnType<typeof fit>, k: number) {
    const cols = shown.length;
    return { ox: (k - (cols - 1) / 2) * UNIT_PITCH_X, oy: 0 };
  }

  function pointerEye(): (canvas: HTMLCanvasElement) => { x: number; y: number } {
    const pointer = { x: 0, y: 0 };
    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX / window.innerWidth - 0.5;
      pointer.y = e.clientY / window.innerHeight - 0.5;
    });
    return () => ({ ...pointer });
  }

  // The glazing bars stand out of the wall, in front of the resident, so
  // the face must land in a pane. Read the vertical pane borders off the
  // shell marks and centre the tenant in the widest gap leaning away from
  // the lamp; the shoulders may pass behind bars, the face may not.
  function tenantCentre(opening: PaneRect, marks: Mark[], lampSide: number): number {
    const h = opening.bottom - opening.top;
    const xs = [opening.left, opening.right];
    for (const m of marks) {
      if (m.kind === 'stroke' && m.pts.length === 2) {
        const [a, b] = m.pts;
        if (
          Math.abs(a.x - b.x) < 0.02 &&
          Math.abs(a.y - b.y) > h * 0.5 &&
          a.x > opening.left + 0.05 &&
          a.x < opening.right - 0.05
        ) {
          xs.push(Math.round(a.x * 100) / 100);
        }
      }
    }
    const sorted = [...new Set(xs)].sort((p, q) => p - q);
    const centre = (opening.left + opening.right) / 2;
    const target = centre - 0.15 * lampSide;
    const lampX = lampSide === 1 ? opening.right - 0.25 : opening.left + 0.25;
    let best = centre;
    let bestScore = Infinity;
    for (let k = 0; k < sorted.length - 1; k++) {
      const mid = (sorted[k] + sorted[k + 1]) / 2;
      if (sorted[k + 1] - sorted[k] < 0.34) continue;
      if (Math.abs(mid - lampX) < 0.5) continue;
      const score = Math.abs(mid - target);
      if (score < bestScore) {
        bestScore = score;
        best = mid;
      }
    }
    return best;
  }

  // One window scene per plate: shell, the pinned coat stand opposite the
  // lamp, the seated tenant on its chair, sill. No curtain: a rolled
  // curtain would cover the figure it sits behind.
  function tenantPlate(seed: number, i: number, theme: Theme, time: number, ctx: CanvasRenderingContext2D): void {
    const pen = new Pen({ ...DEFAULT_TUNING }, windowSeed(seed, i, 0));
    pen.setTime(time);
    const plan = expandShell(pen.seed);
    const opening: PaneRect = innerRect(plan.faceWidth);
    const rng = fork(pen.seed, 'dna');
    const sill = sillMarks(rng, opening);
    const lamp = pinnedLamp({ location: i % 2 === 0 ? 'right' : 'left' });
    const room = roomOf(opening);
    const lampSide = lamp.location === 'right' ? 1 : -1;
    const shell = shellMarks(plan);
    const cx = tenantCentre(opening, shell, lampSide);
    const x0 = cx - TENANT_W / 2;
    const spot: Spot = { x0, x1: x0 + TENANT_W, floorY: room.bottom, topY: room.bottom - TENANT_H, w: TENANT_W, h: TENANT_H };
    const v = rollVariant(seed, i, lampSide === 1);
    execute(
      [
        ...shell,
        ...drawFurniture({ pieces: [{ kind: 'coatStand', plane: 4, side: lamp.location === 'right' ? 'left' : 'right' }] }, opening),
        ...lampMarks(lamp, opening, theme.isNight),
        ...humaaansTenant(spot, v),
        ...sill,
      ],
      pen,
      ctx,
      windowPalette(pen.seed, theme),
      makeProjection({ x: 0, y: 0 }),
      opening,
    );
  }

  function mountRow(canvas: HTMLCanvasElement, label: HTMLSpanElement, button: HTMLButtonElement): void {
    if (shown.length === 1) {
      const main = document.querySelector('main');
      if (main) main.style.maxWidth = 'none';
      // Tall aspect so the single plate fills the viewport: a widened
      // canvas centres the plate outside a narrow screenshot window.
      canvas.style.height = '1050px';
    }
    let seed = rollSeed();
    const show = () => (label.textContent = `seed ${seed}`);
    show();
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme) => {
        const box = cssBox(canvas);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        const g = fit(box);
        ctx.setTransform(g.scale, 0, 0, g.scale, g.cx, g.cy);
        shown.forEach((i, k) => {
          const { ox, oy } = plateOrigin(g, k);
          ctx.save();
          ctx.translate(ox, oy);
          tenantPlate(seed, i, theme, time, ctx);
          ctx.restore();
        });
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.ink;
        ctx.globalAlpha = 0.75;
        ctx.font = `${Math.max(10, 0.16 * g.scale)}px ${labelFont}`;
        ctx.textAlign = 'center';
        shown.forEach((i, k) => {
          const { ox, oy } = plateOrigin(g, k);
          ctx.fillText(`humaaans ${i + 1}`, g.cx + ox * g.scale, g.cy + oy * g.scale + 0.82 * g.scale);
        });
        ctx.globalAlpha = 1;
      },
      pointerEye(),
    );
    button.addEventListener('click', () => {
      seed = rollSeed();
      show();
    });
  }

  const labelFont = `${getComputedStyle(document.body).getPropertyValue('--typography-body2-fontFamily').trim() || 'sans-serif'}`;

  const el = (id: string) => document.getElementById(id)!;
  mountRow(el('row') as HTMLCanvasElement, el('row-seed'), el('row-reseed') as HTMLButtonElement);
</script>
