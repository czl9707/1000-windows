---
import BaseLayout from '@/components/layouts/BaseLayout.astro';

// The round-four judge view: every reference-backed tenant style from the
// workflow's variant pages, one live frame each. Each frame keeps its own
// re-roll; the pages behind them stay the review source of truth until the
// maker picks.
const STYLES = [
  { slug: 'notion-illustrations', title: 'Notion illustrations' },
  { slug: 'sanaa-presentation-figures', title: 'SANAA presentation figures' },
  { slug: 'jean-jullien', title: 'Jean Jullien' },
  { slug: 'malika-favre', title: 'Malika Favre' },
  { slug: 'quentin-blake', title: 'Quentin Blake' },
  { slug: 'carson-ellis', title: 'Carson Ellis' },
  { slug: 'alegria-corporate-memphis', title: 'Alegria / Corporate Memphis' },
  { slug: 'olimpia-zagnoli', title: 'Olimpia Zagnoli' },
];
---

<BaseLayout title="Human styles">
  <main>
    <h1>Human styles — the reference round</h1>
    <p>
      Eight tenant styles, each implemented from a named, downloaded
      reference and passed by an independent visual reviewer. Every frame is
      the style's own live preview page — three window plates, the coat
      stand pinned as the size anchor, daylight pinned, each with its own
      re-roll. The references and constructions live in the dossier at
      .scratch/refs-wf/dossier.md.
    </p>
    {
      STYLES.map((style) => (
        <section>
          <h2>{style.title}</h2>
          <iframe src={`/prototype/v-${style.slug}`} title={style.title} loading="lazy" />
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem;
  }
  section {
    margin-bottom: 2.5rem;
  }
  h2 {
    margin-bottom: 0.4rem;
  }
  iframe {
    width: 100%;
    height: 560px;
    border: var(--border);
    background: var(--color-paper);
  }
</style>
