---
import BaseLayout from '@/components/layouts/BaseLayout.astro';
---

<BaseLayout title="Furniture bench">
  <main>
    <h1>Furniture bench</h1>
    <p>
      Prototype, throwaway: the eyeball bench for the furniture layer. The
      street rolls for real; the kinds sheet gives every catalogue kind one
      large plate of its own. Day and night follow the page theme; the
      buttons re-roll the benches in place.
    </p>

    <section>
      <h2>The street</h2>
      <canvas id="street" width="900" height="480"></canvas>
      <button id="street-reseed" type="button">New street</button>
      <span id="street-seed"></span>
    </section>

    <section>
      <h2>The kinds</h2>
      <canvas id="kinds" width="900" height="1410"></canvas>
      <button id="kinds-reseed" type="button">New kinds sheet</button>
      <span id="kinds-seed"></span>
      <p>
        One plate per kind — shell, curtain, sill, and a lamp pinned to the
        piece's opposite edge — then two extra plates: the desk again with its
        monitor (the street rolls one rarely, so it is pinned here), and a
        last plate pinning the lamp onto the same edge as the room divider, so
        the lamp reads in front of the piece. Move the pointer: the eye
        follows it and the room drifts by depth. The bar at the bottom cycles
        a single kind — <code>?kind=&lt;name&gt;</code> in the URL — one huge
        plate.
      </p>
    </section>
  </main>

  <div id="kind-switcher">
    <button id="kind-prev" type="button" aria-label="Previous kind">&#8592;</button>
    <button id="kind-label" type="button" aria-label="Back to the full sheet">all kinds</button>
    <button id="kind-next" type="button" aria-label="Next kind">&#8594;</button>
  </div>
</BaseLayout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }
  canvas {
    width: 100%;
    height: auto;
    display: block;
    border: var(--border);
  }
  section {
    margin-bottom: 2rem;
  }
  #kind-switcher {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    background: var(--color-primary-foreground);
    color: var(--color-primary-background);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.3);
    z-index: 10;
  }
  #kind-switcher button {
    background: none;
    border: none;
    color: inherit;
    font: var(--typography-button-fontWeight) var(--typography-button-fontSize)
      var(--typography-button-fontFamily);
    cursor: pointer;
    padding: 0;
  }
  /* The label doubles as the way back to the full sheet. */
  #kind-label {
    min-width: 10ch;
    text-align: center;
    text-decoration: underline;
  }
</style>

<script>
  // PROTOTYPE, throwaway: the furniture layer's eyeball bench, per the land
  // ticket — human eyeball on the wall before the milestone merges. Not a
  // chapter demo: no registry entry, the page mounts its two loops directly.
  import { createDemoLoop, centreUnit, cssBox } from '@/components/demoLoop';
  import { Pen } from '@/pen/pen';
  import { DEFAULT_TUNING } from '@/pen/tuning';
  import { rollSeed } from '@/components/mount';
  import { type Theme } from '@/styling/roles';
  import { windowPalette } from '@/styling/colourway';
  import { fork, windowSeed } from '@/core/randomness/rng';
  import { execute } from '@/core/scene';
  import { drawWindow } from '@/core/window';
  import { shellMarks, expandShell } from '@/core/window-shell';
  import { innerRect } from '@/core/window-shell/shell';
  import { sillMarks } from '@/core/sill';
  import { pinnedLamp } from '@/core/light/light';
  import { lampMarks } from '@/core/light/drawLamp';
  import { drawFurniture } from '@/core/furniture/drawFurniture';
  import { FURNITURE_KINDS, type FurnitureKind, type Screen } from '@/core/furniture/catalogue';
  import { makeProjection } from '@/motion/projection';

  const UNIT_PITCH_X = 2.3;
  const UNIT_PITCH_Y = 1.8;
  const SHEET_COLS = 3;
  const COUNT = 6;

  const KIND_ORDER = FURNITURE_KINDS.map((k) => k.value);

  // ?theme=day|night pins the body attribute the theme tokens themselves
  // follow — furniture judges best in daylight, and the demo loop reads the
  // resolved colours off the body every frame, so the pin carries the page
  // chrome with it.
  const themePin = new URLSearchParams(window.location.search).get('theme');
  if (themePin === 'day' || themePin === 'night') {
    document.body.setAttribute('data-theme', themePin === 'day' ? 'light' : 'dark');
  }

  // ?kind=<name> narrows the kinds sheet to one huge plate; anything else
  // shows the full sheet. Shareable, reload-stable — this is a plain Astro
  // page, so the URL is the only state.
  function currentKind(): FurnitureKind | null {
    const v = new URLSearchParams(window.location.search).get('kind');
    return (KIND_ORDER as string[]).includes(v ?? '') ? (v as FurnitureKind) : null;
  }

  function setKindParam(kind: FurnitureKind | null): void {
    const url = new URL(window.location.href);
    if (kind) url.searchParams.set('kind', kind);
    else url.searchParams.delete('kind');
    history.replaceState(null, '', url);
  }

  function cycleKind(delta: number): void {
    const cur = currentKind();
    const idx = cur ? KIND_ORDER.indexOf(cur) : -1;
    const next = KIND_ORDER[(idx + delta + KIND_ORDER.length) % KIND_ORDER.length]!;
    setKindParam(next);
    showKindLabel();
  }

  function showKindLabel(): void {
    document.getElementById('kind-label')!.textContent = currentKind() ?? 'all kinds';
  }

  // The pointer stands in for the eye, as in the motion strip: the plates
  // drift by depth under the gaze, so the bench shows the parallax the
  // pieces are drawn past the opening to survive.
  function pointerEye(): (canvas: HTMLCanvasElement) => { x: number; y: number } {
    const pointer = { x: 0, y: 0 };
    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX / window.innerWidth - 0.5;
      pointer.y = e.clientY / window.innerHeight - 0.5;
    });
    return () => ({ ...pointer });
  }

  function pens(seed: number): Pen[] {
    return Array.from({ length: COUNT }, (_, i) => new Pen({ ...DEFAULT_TUNING }, windowSeed(seed, i, 0)));
  }

  function layout(ctx: CanvasRenderingContext2D, box: { width: number; height: number; dpr: number }, cols: number, rows: number): void {
    centreUnit(ctx, box, cols * UNIT_PITCH_X, rows * UNIT_PITCH_Y);
  }

  function place(ctx: CanvasRenderingContext2D, i: number, cols: number, rows: number): void {
    ctx.translate(
      ((i % cols) - (cols - 1) / 2) * UNIT_PITCH_X,
      (Math.floor(i / cols) - (rows - 1) / 2) * UNIT_PITCH_Y,
    );
  }

  // The street: the full walk, real rolls, whatever the page theme is.
  function mountStreet(canvas: HTMLCanvasElement, label: HTMLSpanElement, button: HTMLButtonElement): void {
    let seed = rollSeed();
    const show = () => (label.textContent = `seed ${seed}`);
    const rebuild = () => {
      seed = rollSeed();
      show();
      return pens(seed);
    };
    show();
    let street = pens(seed);
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme, eye) => {
        const box = cssBox(canvas);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        layout(ctx, box, SHEET_COLS, Math.ceil(COUNT / SHEET_COLS));
        street.forEach((pen, i) => {
          pen.setTime(time);
          ctx.save();
          place(ctx, i, SHEET_COLS, Math.ceil(COUNT / SHEET_COLS));
          drawWindow(ctx, pen, windowPalette(pen.seed, theme), eye, theme.isNight);
          ctx.restore();
        });
      },
      pointerEye(),
    );
    button.addEventListener('click', () => {
      street = rebuild();
    });
  }

  // The kinds sheet: one pinned piece per kind standing opposite its lamp,
  // the tenant layers assembled as the wall assembles them — then the desk
  // again with its monitor, and a last plate pinning the lamp onto the
  // piece's own edge, so the lamp in front of the furniture reads where it
  // can actually overlap. ?kind= collapses the sheet to that one kind, one
  // huge plate.
  interface KindPlate {
    kind: FurnitureKind;
    plane: 2 | 3 | 4 | 5 | 6;
    side: 'left' | 'right';
    screen: Screen | undefined;
    lampLocation: 'innerLeft' | 'innerRight' | 'left' | 'right';
  }

  function sheetPlates(): KindPlate[] {
    const planes = [2, 3, 4, 5, 6] as const;
    const pins = [
      {
        kind: 'desk' as const,
        plane: 4 as const,
        side: 'right' as const,
        screen: 'monitor' as const,
        lampLocation: 'innerLeft' as const,
      },
      {
        kind: 'roomDivider' as const,
        plane: 3 as const,
        side: 'left' as const,
        screen: undefined,
        lampLocation: 'left' as const,
      },
    ];
    return [
      ...KIND_ORDER.map((kind, i) => ({
        kind,
        plane: planes[i % planes.length],
        side: (i % 2 === 0 ? 'left' : 'right') as 'left' | 'right',
        screen: (kind === 'desk' ? 'laptop' : undefined) as Screen | undefined,
        lampLocation: (i % 2 === 0 ? 'innerRight' : 'innerLeft') as 'innerRight' | 'innerLeft',
      })),
      ...pins,
    ];
  }

  const labelFont = `${getComputedStyle(document.body).getPropertyValue('--typography-body2-fontFamily').trim() || 'sans-serif'}`;

  function mountKinds(canvas: HTMLCanvasElement, label: HTMLSpanElement, button: HTMLButtonElement): void {
    let seed = rollSeed();
    const show = () => (label.textContent = `seed ${seed}`);
    show();
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme, eye) => {
        const box = cssBox(canvas);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        const one = currentKind();
        // The desk pins twice (laptop, monitor): a kind's every plate shows.
        const plates = one
          ? sheetPlates().filter((p) => p.kind === one)
          : sheetPlates();
        const cols = one ? plates.length : SHEET_COLS;
        const rows = Math.ceil(plates.length / cols);
        layout(ctx, box, cols, rows);
        plates.forEach((p, i) => {
          const pen = new Pen({ ...DEFAULT_TUNING }, windowSeed(seed, i, 0));
          pen.setTime(time);
          const plan = expandShell(pen.seed);
          const opening = innerRect(plan.faceWidth);
          const rng = fork(pen.seed, 'dna');
          const sill = sillMarks(rng, opening);
          const lamp = pinnedLamp({ location: p.lampLocation });
          ctx.save();
          place(ctx, i, cols, rows);
          // No curtain here: the sheet judges furniture, and a rolled
          // curtain covering its own plate defeats the plate. The street
          // keeps the real rolls.
          execute(
            [
              ...shellMarks(plan),
              ...lampMarks(lamp, opening, theme.isNight),
              ...drawFurniture({ pieces: [{ kind: p.kind, plane: p.plane, side: p.side, screen: p.screen }] }, opening),
              ...sill,
            ],
            pen,
            ctx,
            windowPalette(pen.seed, theme),
            makeProjection(eye),
            opening,
          );
          ctx.restore();
          // The kind's name under its plate, in the page's ink — a judging
          // sheet labels its exhibits.
          ctx.save();
          ctx.fillStyle = theme.ink;
          ctx.globalAlpha = 0.7;
          ctx.font = `0.16px ${labelFont}`;
          ctx.textAlign = 'center';
          ctx.fillText(p.kind, 0, 0.78);
          ctx.restore();
        });
      },
      pointerEye(),
    );
    button.addEventListener('click', () => {
      seed = rollSeed();
      show();
    });
  }

  const el = (id: string) => document.getElementById(id)!;
  mountStreet(
    el('street') as HTMLCanvasElement,
    el('street-seed'),
    el('street-reseed') as HTMLButtonElement,
  );
  mountKinds(
    el('kinds') as HTMLCanvasElement,
    el('kinds-seed'),
    el('kinds-reseed') as HTMLButtonElement,
  );

  showKindLabel();
  document.getElementById('kind-prev')!.addEventListener('click', () => cycleKind(-1));
  document.getElementById('kind-next')!.addEventListener('click', () => cycleKind(1));
  document.getElementById('kind-label')!.addEventListener('click', () => {
    setKindParam(null);
    showKindLabel();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    const t = e.target as HTMLElement | null;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
    e.preventDefault();
    cycleKind(e.key === 'ArrowLeft' ? -1 : 1);
  });
</script>
