---
import BaseLayout from '@/components/layouts/BaseLayout.astro';
---

<BaseLayout title="Furniture bench">
  <main>
    <h1>Furniture bench</h1>
    <p>
      Prototype, throwaway: the eyeball bench for the furniture layer. The
      street rolls for real; the kinds row pins one piece per window beside
      its lamp. Day and night follow the page theme; the buttons re-roll the
      benches in place.
    </p>

    <section>
      <h2>The street</h2>
      <canvas id="street" width="900" height="480"></canvas>
      <button id="street-reseed" type="button">New street</button>
      <span id="street-seed"></span>
    </section>

    <section>
      <h2>The kinds</h2>
      <canvas id="kinds" width="900" height="480"></canvas>
      <button id="kinds-reseed" type="button">New kinds row</button>
      <span id="kinds-seed"></span>
      <p>
        One piece per window, its lamp pinned to the opposite edge — then the
        desk again with its monitor (the street rolls one rarely, so it is
        pinned here), and a last plate pinning the lamp onto the same edge as
        the room divider, so the lamp reads in front of the piece. Move the
        pointer: the eye follows it and the room drifts by depth.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }
  canvas {
    width: 100%;
    height: auto;
    display: block;
    border: var(--border);
  }
  section {
    margin-bottom: 2rem;
  }
</style>

<script>
  // PROTOTYPE, throwaway: the furniture layer's eyeball bench, per the land
  // ticket — human eyeball on the wall before the milestone merges. Not a
  // chapter demo: no registry entry, the page mounts its two loops directly.
  import { createDemoLoop, centreUnit, cssBox } from '@/components/demoLoop';
  import { Pen } from '@/pen/pen';
  import { DEFAULT_TUNING } from '@/pen/tuning';
  import { rollSeed } from '@/components/mount';
  import { type Theme } from '@/styling/roles';
  import { windowPalette } from '@/styling/colourway';
  import { fork, windowSeed } from '@/core/randomness/rng';
  import { execute } from '@/core/scene';
  import { drawWindow } from '@/core/window';
  import { shellMarks, expandShell } from '@/core/window-shell';
  import { innerRect } from '@/core/window-shell/shell';
  import { curtainMarks } from '@/core/curtain';
  import { sillMarks } from '@/core/sill';
  import { pinnedLamp } from '@/core/light/light';
  import { lampMarks } from '@/core/light/drawLamp';
  import { drawFurniture } from '@/core/furniture/drawFurniture';
  import { FURNITURE_KINDS, type Screen } from '@/core/furniture/catalogue';
  import { makeProjection } from '@/motion/projection';

  const UNIT_PITCH_X = 2.3;
  const UNIT_PITCH_Y = 2.25;
  const COUNT = 6;

  // The pointer stands in for the eye, as in the motion strip: the plates
  // drift by depth under the gaze, so the bench shows the parallax the
  // pieces are drawn past the opening to survive.
  function pointerEye(): (canvas: HTMLCanvasElement) => { x: number; y: number } {
    const pointer = { x: 0, y: 0 };
    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX / window.innerWidth - 0.5;
      pointer.y = e.clientY / window.innerHeight - 0.5;
    });
    return () => ({ ...pointer });
  }

  function pens(seed: number): Pen[] {
    return Array.from({ length: COUNT }, (_, i) => new Pen({ ...DEFAULT_TUNING }, windowSeed(seed, i, 0)));
  }

  function layout(ctx: CanvasRenderingContext2D, box: { width: number; height: number; dpr: number }, count: number): void {
    const cols = 3;
    const rows = Math.ceil(count / cols);
    centreUnit(ctx, box, cols * UNIT_PITCH_X, rows * UNIT_PITCH_Y);
  }

  function place(ctx: CanvasRenderingContext2D, i: number, count: number): void {
    const cols = 3;
    const rows = Math.ceil(count / cols);
    ctx.translate(
      ((i % cols) - (cols - 1) / 2) * UNIT_PITCH_X,
      (Math.floor(i / cols) - (rows - 1) / 2) * UNIT_PITCH_Y,
    );
  }

  // The street: the full walk, real rolls, whatever the page theme is.
  function mountStreet(canvas: HTMLCanvasElement, label: HTMLSpanElement, button: HTMLButtonElement): void {
    let seed = rollSeed();
    const show = () => (label.textContent = `seed ${seed}`);
    const rebuild = () => {
      seed = rollSeed();
      show();
      return pens(seed);
    };
    show();
    let street = pens(seed);
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme, eye) => {
        const box = cssBox(canvas);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        layout(ctx, box, COUNT);
        street.forEach((pen, i) => {
          pen.setTime(time);
          ctx.save();
          place(ctx, i, COUNT);
          drawWindow(ctx, pen, windowPalette(pen.seed, theme), eye, theme.isNight);
          ctx.restore();
        });
      },
      pointerEye(),
    );
    button.addEventListener('click', () => {
      street = rebuild();
    });
  }

  // The kinds row: one pinned piece per window standing opposite its lamp,
  // the tenant layers assembled as the wall assembles them — then the desk
  // again with its monitor, and a last plate pinning the lamp onto the
  // piece's own edge, so the lamp in front of the furniture reads where it
  // can actually overlap.
  function mountKinds(canvas: HTMLCanvasElement, label: HTMLSpanElement, button: HTMLButtonElement): void {
    let seed = rollSeed();
    const show = () => (label.textContent = `seed ${seed}`);
    show();
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme, eye) => {
        const box = cssBox(canvas);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        const kinds = FURNITURE_KINDS.map((k) => k.value);
        const plates = [...kinds.map((kind, i) => ({
          kind,
          plane: ([2, 3, 4, 5, 6] as const)[i],
          side: (i % 2 === 0 ? 'left' : 'right') as 'left' | 'right',
          screen: (kind === 'desk' ? 'laptop' : undefined) as Screen | undefined,
          lampLocation: (i % 2 === 0 ? 'innerRight' : 'innerLeft') as 'innerRight' | 'innerLeft',
        })), {
          kind: 'desk' as const,
          plane: 4 as const,
          side: 'right' as const,
          screen: 'monitor' as const,
          lampLocation: 'innerLeft' as const,
        }, {
          kind: 'roomDivider' as const,
          plane: 3 as const,
          side: 'left' as const,
          screen: undefined,
          lampLocation: 'left' as const,
        }];
        layout(ctx, box, plates.length);
        plates.forEach((p, i) => {
          const pen = new Pen({ ...DEFAULT_TUNING }, windowSeed(seed, i, 0));
          pen.setTime(time);
          const plan = expandShell(pen.seed);
          const opening = innerRect(plan.faceWidth);
          const rng = fork(pen.seed, 'dna');
          const curtain = curtainMarks(rng, opening);
          const sill = sillMarks(rng, opening);
          const lamp = pinnedLamp({ location: p.lampLocation });
          ctx.save();
          place(ctx, i, plates.length);
          execute(
            [
              ...shellMarks(plan),
              ...lampMarks(lamp, opening, theme.isNight),
              ...drawFurniture({ pieces: [{ kind: p.kind, plane: p.plane, side: p.side, screen: p.screen }] }, opening),
              ...curtain,
              ...sill,
            ],
            pen,
            ctx,
            windowPalette(pen.seed, theme),
            makeProjection(eye),
            opening,
          );
          ctx.restore();
        });
      },
      pointerEye(),
    );
    button.addEventListener('click', () => {
      seed = rollSeed();
      show();
    });
  }

  const el = (id: string) => document.getElementById(id)!;
  mountStreet(
    el('street') as HTMLCanvasElement,
    el('street-seed'),
    el('street-reseed') as HTMLButtonElement,
  );
  mountKinds(
    el('kinds') as HTMLCanvasElement,
    el('kinds-seed'),
    el('kinds-reseed') as HTMLButtonElement,
  );
</script>
