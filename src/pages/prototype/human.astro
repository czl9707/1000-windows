---
import BaseLayout from '@/components/layouts/BaseLayout.astro';
---

<BaseLayout title="Human bench">
  <main>
    <h1>Human bench</h1>
    <p>
      Prototype, throwaway, round two: ten styles of drawing the tenant, one
      pose — standing, facing out — so only the style varies. Round one died
      at the eyeball: pictogram heads on giant bodies. This round borrows its
      proportions from the classic window silhouette (head a seventh of the
      body, neck under the chin, shoulders twice the head) and its vocabulary
      from the reference's head chapters — the hair carries the outline, the
      face stays an absence. Every plate pins a coat stand on the room's far
      side so the size judgment has an anchor. The sheet gives every style one
      large plate; the strip shows the same windows at street density. A
      standing tenant of height 1.68 on the room floor shows head, neck, and
      shoulder slope above the sightline — the same band the bookcase top
      reaches. Daylight pinned; the button re-rolls in place.
    </p>

    <section>
      <h2>The styles</h2>
      <canvas id="kinds" width="900" height="1500"></canvas>
      <button id="kinds-reseed" type="button">New sheet</button>
      <span id="kinds-seed"></span>
    </section>

    <section>
      <h2>The street strip</h2>
      <canvas id="strip" width="900" height="290"></canvas>
      <p>Same windows, five to a row at half pitch — the far-wall density.</p>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }
  canvas {
    width: 100%;
    height: auto;
    display: block;
    border: var(--border);
  }
  section {
    margin-bottom: 2rem;
  }
</style>

<script>
  // PROTOTYPE, throwaway: candidate styles for the tenant silhouette,
  // drawn as marks into a real window scene. The style the eye picks
  // graduates into the occupant layer; this page does not survive the
  // milestone.
  import { createDemoLoop, cssBox } from '@/components/demoLoop';
  import { Pen } from '@/pen/pen';
  import { DEFAULT_TUNING } from '@/pen/tuning';
  import { rollSeed } from '@/components/mount';
  import type { Theme, ColorRole } from '@/styling/roles';
  import { WEIGHTS } from '@/styling/weights';
  import { windowPalette } from '@/styling/colourway';
  import { fork, windowSeed } from '@/core/randomness/rng';
  import { execute, type Mark } from '@/core/scene';
  import { shellMarks, expandShell } from '@/core/window-shell';
  import { innerRect, type PaneRect } from '@/core/window-shell/shell';
  import { sillMarks } from '@/core/sill';
  import { pinnedLamp } from '@/core/light/light';
  import { lampMarks } from '@/core/light/drawLamp';
  import type { Pt3 } from '@/motion/projection';
  import { roomOf } from '@/core/furniture/room';
  import { drawFurniture } from '@/core/furniture/drawFurniture';
  import { makeProjection } from '@/motion/projection';

  const UNIT_PITCH_X = 2.3;
  const UNIT_PITCH_Y = 1.8;

  // Daylight pinned: the interior judges best with the lamps dark.
  document.body.setAttribute('data-theme', 'light');

  // The tenant stands on the room floor at a furniture plane — a resident
  // among the pieces, not a giant glued to the glass.
  const TENANT_DEPTH = -0.15;
  const TENANT_Z = -8.8;
  const atT = () => TENANT_DEPTH;
  const zT = () => TENANT_Z;

  interface Spot {
    x0: number;
    x1: number;
    floorY: number;
    topY: number;
    w: number;
    h: number;
  }

  interface Candidate {
    name: string;
    w: number;
    h: number;
    draw: (s: Spot, hair: Hair) => Mark[];
  }

  const mass = (role: ColorRole, pts: Pt3[]): Mark => ({ kind: 'fill', pts, role, z: zT() });
  const stroke = (role: ColorRole, pts: Pt3[], name: string, widthUnits: number): Mark => ({
    kind: 'stroke',
    pts,
    name,
    widthUnits,
    role,
    z: zT(),
  });
  const dot = (role: ColorRole, p: { x: number; y: number }, r: number, name: string): Mark => ({
    kind: 'dot',
    pts: [{ x: p.x, y: p.y, z: atT() }],
    role,
    z: zT(),
    name,
    r,
  });
  const cxOf = (s: Spot) => (s.x0 + s.x1) / 2;

  // One ellipse ring; rx and ry may differ — the skull is taller than wide.
  function ellipse(cx: number, cy: number, rx: number, ry: number, n = 16): Pt3[] {
    const pts: Pt3[] = [];
    for (let i = 0; i < n; i++) {
      const a = (i / n) * Math.PI * 2;
      pts.push({ x: cx + Math.cos(a) * rx, y: cy + Math.sin(a) * ry, z: atT() });
    }
    return pts;
  }

  const circ = (cx: number, cy: number, r: number, n = 14) => ellipse(cx, cy, r, r, n);

  // The tenant's anthropometry, off the standing height: the head a seventh
  // of it, the shoulders a head and a half across, a real neck. Real body,
  // not the pictogram of round one.
  interface Build {
    cx: number;
    crownY: number;
    hairY: number;
    headCY: number;
    headRx: number;
    headRy: number;
    chinY: number;
    neckW: number;
    shoulderY: number;
    shoulderX: number;
    sightY: number;
  }

  function build(s: Spot, height: number): Build {
    const cx = cxOf(s) + 0.012 * s.h * Math.sin(s.x0 * 9.1);
    const crownY = s.floorY - height;
    const headRx = height * 0.063;
    const headRy = height * 0.074;
    const hairLift = height * 0.02;
    const headCY = crownY + hairLift + headRy;
    const chinY = headCY + headRy * 0.95;
    const shoulderY = chinY + height * 0.065;
    return {
      cx,
      crownY,
      hairY: crownY + hairLift * 0.4,
      headCY,
      headRx,
      headRy,
      chinY,
      neckW: height * 0.033,
      shoulderY,
      shoulderX: height * 0.125,
      sightY: s.floorY - 0.85,
    };
  }

  // Hair rolls per tenant and carries the crown's outline: the reference's
  // trick — the hairdo is where a person stops being an egg.
  type Hair = 'crop' | 'bun' | 'curls' | 'sidePart';

  function rollHair(seed: number, i: number): Hair {
    const r = fork(windowSeed(seed, i, 0), 'tenant-hair');
    return r.weighted([
      { value: 'crop' as const, weight: 3 },
      { value: 'bun' as const, weight: 2 },
      { value: 'curls' as const, weight: 2 },
      { value: 'sidePart' as const, weight: 2 },
    ]);
  }

  function hairMarks(role: ColorRole, b: Build, hair: Hair): Mark[] {
    const marks: Mark[] = [];
    const capRx = b.headRx * 1.12;
    const capRy = b.headRy * 1.05;
    const capY = b.headCY - b.headRy * 0.32;
    if (hair === 'crop' || hair === 'sidePart') {
      const shift = hair === 'sidePart' ? b.headRx * 0.28 : 0;
      marks.push(mass(role, ellipse(b.cx + shift, capY, capRx, capRy)));
    } else if (hair === 'curls') {
      for (const off of [-0.7, -0.2, 0.3, 0.75]) {
        marks.push(mass(role, circ(b.cx + off * capRx, capY - capRy * 0.35 + Math.abs(off) * capRy * 0.3, b.headRx * 0.42)));
      }
    } else {
      marks.push(mass(role, ellipse(b.cx, capY, capRx, capRy)));
      marks.push(mass(role, circ(b.cx + b.headRx * 0.55, b.crownY + b.headRy * 0.28, b.headRx * 0.4)));
    }
    return marks;
  }

  // The bust mass: skull, neck, and the shoulder slope down past the
  // sightline. One role, stacked — the tremor melts the joins into one
  // silhouette.
  function bustMass(role: ColorRole, b: Build): Mark[] {
    return [
      mass(role, ellipse(b.cx, b.headCY, b.headRx, b.headRy)),
      mass(role, [
        { x: b.cx - b.neckW, y: b.chinY - b.headRy * 0.2, z: atT() },
        { x: b.cx + b.neckW, y: b.chinY - b.headRy * 0.2, z: atT() },
        { x: b.cx + b.neckW * 1.4, y: b.shoulderY + 0.03, z: atT() },
        { x: b.cx - b.neckW * 1.4, y: b.shoulderY + 0.03, z: atT() },
      ]),
      mass(role, [
        { x: b.cx - b.neckW * 1.2, y: b.shoulderY, z: atT() },
        { x: b.cx + b.neckW * 1.2, y: b.shoulderY, z: atT() },
        { x: b.cx + b.shoulderX, y: b.shoulderY + 0.055, z: atT() },
        { x: b.cx + b.shoulderX * 0.94, y: b.sightY + 0.12, z: atT() },
        { x: b.cx - b.shoulderX * 0.94, y: b.sightY + 0.12, z: atT() },
        { x: b.cx - b.shoulderX, y: b.shoulderY + 0.055, z: atT() },
      ]),
    ];
  }

  // The contour line: over the crown, down the temple, the jaw, into the
  // neck, out along the shoulder slope. One open polyline; the hair edge
  // rides the same path — the reference's frisur over the kopf.
  function bustContour(b: Build, hair: Hair, bottomY: number): { left: Pt3[]; right: Pt3[] } {
    const capRx = b.headRx * (hair === 'crop' || hair === 'bun' ? 1.12 : 1.0);
    const capTop = b.crownY + b.headRy * 0.15;
    const arc = (from: number, to: number, rx: number, ry: number, cy: number, n = 9): Pt3[] =>
      Array.from({ length: n + 1 }, (_, i) => {
        const a = from + (i / n) * (to - from);
        return { x: b.cx + Math.cos(a) * rx, y: cy - Math.sin(a) * ry, z: atT() };
      });
    const crown = arc(Math.PI, 0, capRx, b.headRy * 1.05, capTop + b.headRy * 0.85);
    const temple = (side: number): Pt3[] => [
      { x: b.cx + side * capRx, y: b.headCY - b.headRy * 0.2, z: atT() },
      { x: b.cx + side * b.headRx * 0.92, y: b.chinY, z: atT() },
      { x: b.cx + side * b.neckW * 0.9, y: b.shoulderY - 0.02, z: atT() },
      { x: b.cx + side * b.shoulderX * 0.96, y: b.shoulderY + 0.06, z: atT() },
      { x: b.cx + side * b.shoulderX * 0.94, y: bottomY, z: atT() },
    ];
    return { left: [...temple(-1), ...crown], right: temple(1) };
  }

  const CANDIDATES: Candidate[] = [
    // 1. The classic back-lit silhouette, correctly proportioned: ink head,
    // neck, shoulder slope, the hair carrying the crown's outline.
    {
      name: 'inkBust',
      w: 0.42,
      h: 1.68,
      draw: (s, hair) => {
        const b = build(s, 1.68);
        return [...bustMass('ink', b), ...hairMarks('ink', b, hair)];
      },
    },
    // 2. The standing figure in ink — arms hinted as sleeve masses beside
    // the torso, legs below the sightline stay under the clip.
    {
      name: 'inkFigure',
      w: 0.4,
      h: 1.68,
      draw: (s, hair) => {
        const b = build(s, 1.68);
        const marks = [...bustMass('ink', b), ...hairMarks('ink', b, hair)];
        for (const side of [-1, 1]) {
          marks.push(
            mass('ink', [
              { x: b.cx + side * b.shoulderX * 0.82, y: b.shoulderY + 0.07, z: atT() },
              { x: b.cx + side * b.shoulderX * 0.95, y: b.shoulderY + 0.1, z: atT() },
              { x: b.cx + side * b.shoulderX * 0.88, y: b.sightY + 0.1, z: atT() },
              { x: b.cx + side * b.shoulderX * 0.74, y: b.sightY + 0.1, z: atT() },
            ]),
          );
        }
        return marks;
      },
    },
    // 3. The bust in the furniture gray at its own plane — a resident among
    // the pieces, the coat stand's neighbour.
    {
      name: 'grayBust',
      w: 0.42,
      h: 1.68,
      draw: (s, hair) => {
        const b = build(s, 1.68);
        return [...bustMass('furniture4', b), ...hairMarks('furniture4', b, hair)];
      },
    },
    // 4. The pure contour: one line over the crown and down both sides, no
    // fill — the drawn tenant for unlit rooms.
    {
      name: 'lineBust',
      w: 0.42,
      h: 1.68,
      draw: (s, hair) => {
        const b = build(s, 1.68);
        const { left, right } = bustContour(b, hair, b.sightY + 0.1);
        return [
          stroke('ink', left, 'lineBust-left', WEIGHTS.outline),
          stroke('ink', right, 'lineBust-right', WEIGHTS.outline),
        ];
      },
    },
    // 5. The contour with a face: two eye dots and a mouth line — identity
    // at the smallest scale the dot construction survives.
    {
      name: 'lineFace',
      w: 0.42,
      h: 1.68,
      draw: (s, hair) => {
        const b = build(s, 1.68);
        const { left, right } = bustContour(b, hair, b.sightY + 0.1);
        const eyeY = b.headCY - b.headRy * 0.05;
        return [
          stroke('ink', left, 'lineFace-left', WEIGHTS.outline),
          stroke('ink', right, 'lineFace-right', WEIGHTS.outline),
          dot('ink', { x: b.cx - b.headRx * 0.42, y: eyeY }, b.headRx * 0.14, 'lineFace-eyeL'),
          dot('ink', { x: b.cx + b.headRx * 0.42, y: eyeY }, b.headRx * 0.14, 'lineFace-eyeR'),
          stroke(
            'ink',
            [
              { x: b.cx - b.headRx * 0.3, y: b.chinY - b.headRy * 0.28, z: atT() },
              { x: b.cx + b.headRx * 0.3, y: b.chinY - b.headRy * 0.28, z: atT() },
            ],
            'lineFace-mouth',
            WEIGHTS.detail,
          ),
        ];
      },
    },
    // 6. The profile: forehead, nose, chin, the hair mass at the back of the
    // head — the silhouette-cut view, most human per line.
    {
      name: 'profile',
      w: 0.42,
      h: 1.68,
      draw: (s, hair) => {
        const b = build(s, 1.68);
        const face = b.cx + b.headRx * 0.3;
        const marks: Mark[] = [
          mass('ink', ellipse(b.cx, b.headCY, b.headRx * 0.92, b.headRy)),
          mass('ink', [
            { x: face + b.headRx * 0.55, y: b.headCY - b.headRy * 0.55, z: atT() },
            { x: face + b.headRx * 0.72, y: b.headCY + b.headRy * 0.05, z: atT() },
            { x: face + b.headRx * 0.58, y: b.headCY + b.headRy * 0.3, z: atT() },
            { x: face + b.headRx * 0.3, y: b.headCY + b.headRy * 0.55, z: atT() },
          ]),
          ...bustMass('ink', b),
        ];
        const capRx = b.headRx * 1.15;
        marks.push(mass('ink', ellipse(b.cx - b.headRx * 0.25, b.headCY - b.headRy * 0.32, capRx, b.headRy * 1.02)));
        return marks;
      },
    },
    // 7. The rim-lit tenant: the ink silhouette with the paper catching the
    // crown of the hair and the shoulder tops — the back-lit edge.
    {
      name: 'rimLit',
      w: 0.42,
      h: 1.68,
      draw: (s, hair) => {
        const b = build(s, 1.68);
        const capRx = b.headRx * 1.1;
        const rimArc: Pt3[] = Array.from({ length: 8 }, (_, i) => {
          const a = Math.PI * (1 - i / 7);
          return { x: b.cx + Math.cos(a) * capRx, y: b.headCY - b.headRy * 0.3 - Math.sin(a) * b.headRy * 1.02, z: atT() };
        });
        return [
          ...bustMass('ink', b),
          ...hairMarks('ink', b, hair),
          stroke('paper', rimArc, 'rimLit-crown', WEIGHTS.hairline),
          stroke(
            'paper',
            [
              { x: b.cx - b.shoulderX * 0.96, y: b.shoulderY + 0.07, z: atT() },
              { x: b.cx - b.neckW * 1.3, y: b.shoulderY + 0.01, z: atT() },
            ],
            'rimLit-shoulderL',
            WEIGHTS.hairline,
          ),
          stroke(
            'paper',
            [
              { x: b.cx + b.neckW * 1.3, y: b.shoulderY + 0.01, z: atT() },
              { x: b.cx + b.shoulderX * 0.96, y: b.shoulderY + 0.07, z: atT() },
            ],
            'rimLit-shoulderR',
            WEIGHTS.hairline,
          ),
        ];
      },
    },
    // 8. The back-lit bust: the warm room glow pooling behind the head and
    // shoulders, the ink silhouette in front.
    {
      name: 'backlit',
      w: 0.5,
      h: 1.68,
      draw: (s, hair) => {
        const b = build(s, 1.68);
        return [
          mass('ambient', circ(b.cx, b.headCY + 0.06, b.headRy * 2.6, 18)),
          mass('ambient', [
            { x: b.cx - b.shoulderX * 1.9, y: b.shoulderY - 0.02, z: atT() },
            { x: b.cx + b.shoulderX * 1.9, y: b.shoulderY - 0.02, z: atT() },
            { x: b.cx + b.shoulderX * 1.6, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX * 1.6, y: b.sightY + 0.12, z: atT() },
          ]),
          ...bustMass('ink', b),
          ...hairMarks('ink', b, hair),
        ];
      },
    },
    // 9. The seated tenant: crown at the pane's upper third, hunched
    // shoulders — the reader at the window, lower than the furniture.
    {
      name: 'seated',
      w: 0.46,
      h: 1.3,
      draw: (s, hair) => {
        const b = build(s, 1.3);
        const hunched = b.shoulderX * 1.18;
        return [
          mass('ink', ellipse(b.cx, b.headCY, b.headRx, b.headRy)),
          mass('ink', [
            { x: b.cx - b.neckW * 1.1, y: b.shoulderY - 0.02, z: atT() },
            { x: b.cx + b.neckW * 1.1, y: b.shoulderY - 0.02, z: atT() },
            { x: b.cx + hunched, y: b.shoulderY + 0.08, z: atT() },
            { x: b.cx + hunched * 0.95, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - hunched * 0.95, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - hunched, y: b.shoulderY + 0.08, z: atT() },
          ]),
          ...hairMarks('ink', b, hair),
        ];
      },
    },
    // 10. The phone glow: the ink bust tilting down toward the small warm
    // oval lighting the chin from below.
    {
      name: 'phoneGlow',
      w: 0.42,
      h: 1.68,
      draw: (s, hair) => {
        const b = build(s, 1.68);
        const tilt = b.headRy * 0.12;
        const tilted: Build = { ...b, headCY: b.headCY + tilt, chinY: b.chinY + tilt * 1.4, crownY: b.crownY + tilt };
        const marks: Mark[] = [
          mass('ambient', ellipse(b.cx + b.headRx * 0.5, tilted.chinY + 0.055, b.headRx * 0.42, b.headRx * 0.3)),
          ...bustMass('ink', tilted),
          ...hairMarks('ink', tilted, hair),
        ];
        return marks;
      },
    },
  ];

  const KINDS_SHEET_COLS = 3;
  const STRIP_COLS = 5;

  function fit(box: { width: number; height: number; dpr: number }, cols: number, rows: number) {
    const scale = Math.min(box.width / (cols * UNIT_PITCH_X), box.height / (rows * UNIT_PITCH_Y));
    return { scale: box.dpr * scale, cx: (box.width * box.dpr) / 2, cy: (box.height * box.dpr) / 2 };
  }

  function plateOrigin(g: ReturnType<typeof fit>, i: number, cols: number, rows: number) {
    const ox = ((i % cols) - (cols - 1) / 2) * UNIT_PITCH_X;
    const oy = (Math.floor(i / cols) - (rows - 1) / 2) * UNIT_PITCH_Y;
    return { ox, oy };
  }

  function pointerEye(): (canvas: HTMLCanvasElement) => { x: number; y: number } {
    const pointer = { x: 0, y: 0 };
    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX / window.innerWidth - 0.5;
      pointer.y = e.clientY / window.innerHeight - 0.5;
    });
    return () => ({ ...pointer });
  }

  const labelFont = `${getComputedStyle(document.body).getPropertyValue('--typography-body2-fontFamily').trim() || 'sans-serif'}`;

  // One window scene per style: shell, a pinned coat stand opposite the
  // lamp — the size anchor — the tenant centred on its plane, sill. No
  // curtain: a rolled curtain would cover the figure it sits behind.
  function humanPlate(c: Candidate, seed: number, i: number, theme: Theme, time: number, ctx: CanvasRenderingContext2D): void {
    const pen = new Pen({ ...DEFAULT_TUNING }, windowSeed(seed, i, 0));
    pen.setTime(time);
    const plan = expandShell(pen.seed);
    const opening: PaneRect = innerRect(plan.faceWidth);
    const rng = fork(pen.seed, 'dna');
    const sill = sillMarks(rng, opening);
    const lamp = pinnedLamp({ location: i % 2 === 0 ? 'innerRight' : 'innerLeft' });
    const hair = rollHair(seed, i);
    const room = roomOf(opening);
    const cx = (opening.left + opening.right) / 2;
    const x0 = cx - c.w / 2;
    const spot: Spot = { x0, x1: x0 + c.w, floorY: room.bottom, topY: room.bottom - c.h, w: c.w, h: c.h };
    execute(
      [
        ...shellMarks(plan),
        ...drawFurniture({ pieces: [{ kind: 'coatStand', plane: 4, side: lamp.location === 'innerRight' ? 'left' : 'right' }] }, opening),
        ...lampMarks(lamp, opening, theme.isNight),
        ...c.draw(spot, hair),
        ...sill,
      ],
      pen,
      ctx,
      windowPalette(pen.seed, theme),
      makeProjection({ x: 0, y: 0 }),
      opening,
    );
  }

  function mountKinds(canvas: HTMLCanvasElement, label: HTMLSpanElement, button: HTMLButtonElement): void {
    let seed = rollSeed();
    const show = () => (label.textContent = `seed ${seed}`);
    show();
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme) => {
        const box = cssBox(canvas);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        // ?kind=<name> collapses the sheet to one huge plate — the close
        // look without a screenshot slicer.
        const one = new URLSearchParams(window.location.search).get('kind');
        const shown = CANDIDATES.filter((c) => !one || c.name === one);
        const cols = one ? shown.length : KINDS_SHEET_COLS;
        const rws = Math.ceil(shown.length / cols);
        const g = fit(box, cols, rws);
        ctx.setTransform(g.scale, 0, 0, g.scale, g.cx, g.cy);
        shown.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, cols, rws);
          ctx.save();
          ctx.translate(ox, oy);
          humanPlate(c, seed, i, theme, time, ctx);
          ctx.restore();
        });
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.ink;
        ctx.globalAlpha = 0.75;
        ctx.font = `${Math.max(10, 0.16 * g.scale)}px ${labelFont}`;
        ctx.textAlign = 'center';
        shown.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, cols, rws);
          ctx.fillText(c.name, g.cx + ox * g.scale, g.cy + oy * g.scale + 0.82 * g.scale);
        });
        ctx.globalAlpha = 1;
      },
      pointerEye(),
    );
    button.addEventListener('click', () => {
      seed = rollSeed();
      show();
    });
  }

  function mountStrip(canvas: HTMLCanvasElement): void {
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme) => {
        const box = cssBox(canvas);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        const rows = Math.ceil(CANDIDATES.length / STRIP_COLS);
        const g = fit(box, STRIP_COLS, rows);
        ctx.setTransform(g.scale, 0, 0, g.scale, g.cx, g.cy);
        CANDIDATES.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, STRIP_COLS, rows);
          ctx.save();
          ctx.translate(ox, oy);
          humanPlate(c, 424242, i, theme, time, ctx);
          ctx.restore();
        });
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.ink;
        ctx.globalAlpha = 0.75;
        ctx.font = `${Math.max(9, 0.14 * g.scale)}px ${labelFont}`;
        ctx.textAlign = 'center';
        CANDIDATES.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, STRIP_COLS, rows);
          ctx.fillText(c.name, g.cx + ox * g.scale, g.cy + oy * g.scale + 1.02 * g.scale);
        });
        ctx.globalAlpha = 1;
      },
      pointerEye(),
    );
  }

  const el = (id: string) => document.getElementById(id)!;
  mountKinds(el('kinds') as HTMLCanvasElement, el('kinds-seed'), el('kinds-reseed') as HTMLButtonElement);
  mountStrip(el('strip') as HTMLCanvasElement);
</script>
