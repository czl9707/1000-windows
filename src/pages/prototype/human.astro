---
import BaseLayout from '@/components/layouts/BaseLayout.astro';
---

<BaseLayout title="Human bench">
  <main>
    <h1>Human bench</h1>
    <p>
      Prototype, throwaway, round three: ten illustration styles of drawing
      the tenant — different constructions, not one shape with different
      strokes. Each style names its reference: the SANAA rendering figure,
      Notion's marketing people, the Modulor, watercolour render entourage,
      the Bauhaus instruction figure, the pictogram, the Tokyo-night
      silhouette, the Matisse cut-out, a Sempé ink figure, folk-flat. The
      body follows the furniture's own scale convention — the pieces are
      drawn compressed, and the standing tenant joins them at 1.0–1.42 units
      against the coat stand's 1.4, so the pane shows a resident, the same
      band the room divider reaches. Every plate pins a coat stand for that
      judgment. The sheet gives every style one large plate; the strip shows
      the same windows at street density. Daylight pinned; the button
      re-rolls in place.
    </p>

    <section>
      <h2>The styles</h2>
      <canvas id="kinds" width="900" height="1500"></canvas>
      <button id="kinds-reseed" type="button">New sheet</button>
      <span id="kinds-seed"></span>
    </section>

    <section>
      <h2>The street strip</h2>
      <canvas id="strip" width="900" height="290"></canvas>
      <p>Same windows, five to a row at half pitch — the far-wall density.</p>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }
  canvas {
    width: 100%;
    height: auto;
    display: block;
    border: var(--border);
  }
  section {
    margin-bottom: 2rem;
  }
</style>

<script>
  // PROTOTYPE, throwaway: candidate styles for the tenant silhouette,
  // drawn as marks into a real window scene. The style the eye picks
  // graduates into the occupant layer; this page does not survive the
  // milestone.
  import { createDemoLoop, cssBox } from '@/components/demoLoop';
  import { Pen } from '@/pen/pen';
  import { DEFAULT_TUNING } from '@/pen/tuning';
  import { rollSeed } from '@/components/mount';
  import type { Theme, ColorRole } from '@/styling/roles';
  import { WEIGHTS } from '@/styling/weights';
  import { windowPalette } from '@/styling/colourway';
  import { fork, windowSeed } from '@/core/randomness/rng';
  import { execute, type Mark } from '@/core/scene';
  import { shellMarks, expandShell } from '@/core/window-shell';
  import { innerRect, type PaneRect } from '@/core/window-shell/shell';
  import { sillMarks } from '@/core/sill';
  import { pinnedLamp } from '@/core/light/light';
  import { lampMarks } from '@/core/light/drawLamp';
  import type { Pt3 } from '@/motion/projection';
  import { roomOf } from '@/core/furniture/room';
  import { drawFurniture } from '@/core/furniture/drawFurniture';
  import { makeProjection } from '@/motion/projection';

  const UNIT_PITCH_X = 2.3;
  const UNIT_PITCH_Y = 1.8;

  // Daylight pinned: the interior judges best with the lamps dark.
  document.body.setAttribute('data-theme', 'light');

  // The tenant stands on the room floor at a furniture plane — a resident
  // among the pieces, not a giant glued to the glass.
  const TENANT_DEPTH = -0.15;
  const TENANT_Z = -8.8;
  const atT = () => TENANT_DEPTH;
  const zT = () => TENANT_Z;

  interface Spot {
    x0: number;
    x1: number;
    floorY: number;
    topY: number;
    w: number;
    h: number;
  }

  interface Candidate {
    name: string;
    w: number;
    h: number;
    draw: (s: Spot, hair: Hair) => Mark[];
  }

  const mass = (role: ColorRole, pts: Pt3[]): Mark => ({ kind: 'fill', pts, role, z: zT() });
  const stroke = (role: ColorRole, pts: Pt3[], name: string, widthUnits: number): Mark => ({
    kind: 'stroke',
    pts,
    name,
    widthUnits,
    role,
    z: zT(),
  });
  const dot = (role: ColorRole, p: { x: number; y: number }, r: number, name: string): Mark => ({
    kind: 'dot',
    pts: [{ x: p.x, y: p.y, z: atT() }],
    role,
    z: zT(),
    name,
    r,
  });
  const cxOf = (s: Spot) => (s.x0 + s.x1) / 2;

  // Where every tenant meets its room: the x centre with its per-window
  // drift, the floor, the sightline the aperture cuts at.
  function base(s: Spot, height: number) {
    const sightY = s.floorY - 0.85;
    return {
      cx: cxOf(s) + 0.012 * s.h * Math.sin(s.x0 * 9.1),
      crownY: s.floorY - height,
      floorY: s.floorY,
      sightY,
    };
  }

  function ellipse(cx: number, cy: number, rx: number, ry: number, n = 16): Pt3[] {
    const pts: Pt3[] = [];
    for (let i = 0; i < n; i++) {
      const a = (i / n) * Math.PI * 2;
      pts.push({ x: cx + Math.cos(a) * rx, y: cy + Math.sin(a) * ry, z: atT() });
    }
    return pts;
  }

  const circ = (cx: number, cy: number, r: number, n = 14) => ellipse(cx, cy, r, r, n);

  type Hair = 'crop' | 'bun' | 'curls' | 'sidePart';

  function rollHair(seed: number, i: number): Hair {
    const r = fork(windowSeed(seed, i, 0), 'tenant-hair');
    return r.weighted([
      { value: 'crop' as const, weight: 3 },
      { value: 'bun' as const, weight: 2 },
      { value: 'curls' as const, weight: 2 },
      { value: 'sidePart' as const, weight: 2 },
    ]);
  }

  // A hair blob over a head circle: the outline above the skull is where a
  // person stops being an egg (the reference's frisur layer).
  function hairBlob(role: ColorRole, cx: number, headCY: number, headR: number, hair: Hair): Mark[] {
    const marks: Mark[] = [];
    const capY = headCY - headR * 0.35;
    if (hair === 'crop' || hair === 'sidePart') {
      const shift = hair === 'sidePart' ? headR * 0.3 : 0;
      marks.push(mass(role, ellipse(cx + shift, capY, headR * 1.1, headR * 1.02)));
    } else if (hair === 'curls') {
      for (const off of [-0.7, -0.2, 0.3, 0.75]) {
        marks.push(mass(role, circ(cx + off * headR * 1.1, capY - headR * 0.3 + Math.abs(off) * headR * 0.35, headR * 0.45)));
      }
    } else {
      marks.push(mass(role, ellipse(cx, capY, headR * 1.1, headR * 1.02)));
      marks.push(mass(role, circ(cx + headR * 0.6, headCY - headR * 1.15, headR * 0.42)));
    }
    return marks;
  }

  const CANDIDATES: Candidate[] = [
    // 1. The SANAA rendering figure: a pale, featureless, slightly-too-small
    // resident lost in the room — the smallness is the statement. Barely a
    // head bump over the sightline.
    {
      name: 'sejima',
      w: 0.24,
      h: 1.05,
      draw: (s) => {
        const b = base(s, 1.05);
        const headR = 0.055;
        const headCY = b.crownY + headR;
        const bodyX = 0.075;
        return [
          mass('furniture6', circ(b.cx, headCY, headR, 12)),
          mass('furniture6', [
            { x: b.cx - bodyX, y: headCY + headR * 0.6, z: atT() },
            { x: b.cx + bodyX, y: headCY + headR * 0.6, z: atT() },
            { x: b.cx + bodyX * 0.8, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 0.8, y: b.sightY + 0.1, z: atT() },
          ]),
        ];
      },
    },
    // 2. The Notion-marketing person: solid dark blob head without a face,
    // long body in one muted flat, a hint of one bent arm, a slight lean.
    {
      name: 'notion',
      w: 0.44,
      h: 1.35,
      draw: (s, hair) => {
        const b = base(s, 1.35);
        const lean = b.cx + 0.02;
        const headR = 0.088;
        const headCY = b.crownY + headR * 1.15;
        const bodyX = 0.15;
        const bodyTop = headCY + headR * 1.5;
        return [
          ...hairBlob('ink', lean, headCY, headR, hair),
          mass('ink', circ(lean, headCY, headR)),
          mass('fabric', [
            { x: lean - bodyX * 0.72, y: bodyTop, z: atT() },
            { x: lean + bodyX * 0.72, y: bodyTop, z: atT() },
            { x: lean + bodyX, y: bodyTop + (b.sightY - bodyTop) * 0.45, z: atT() },
            { x: lean + bodyX * 0.88, y: b.sightY + 0.1, z: atT() },
            { x: lean - bodyX * 0.88, y: b.sightY + 0.1, z: atT() },
            { x: lean - bodyX, y: bodyTop + (b.sightY - bodyTop) * 0.45, z: atT() },
          ]),
          stroke(
            'ink',
            [
              { x: lean - bodyX * 0.8, y: bodyTop + 0.04, z: atT() },
              { x: lean - bodyX * 1.15, y: bodyTop + 0.13, z: atT() },
              { x: lean - bodyX * 1.05, y: bodyTop + 0.26, z: atT() },
            ],
            'notion-arm',
            WEIGHTS.outline,
          ),
        ];
      },
    },
    // 3. The Modulor: Le Corbusier's scale figure — an upright, rigid,
    // flat-cut silhouette standing to attention, the architecture drawing's
    // yardstick.
    {
      name: 'modulor',
      w: 0.4,
      h: 1.42,
      draw: (s) => {
        const b = base(s, 1.42);
        const headR = 0.07;
        const headCY = b.crownY + headR;
        const shoulderY = headCY + headR + 0.02;
        const bodyX = 0.13;
        const armX = 0.16;
        return [
          mass('ink', ellipse(b.cx, headCY, headR * 0.85, headR)),
          mass('ink', [
            { x: b.cx - bodyX, y: shoulderY + 0.05, z: atT() },
            { x: b.cx + bodyX, y: shoulderY + 0.05, z: atT() },
            { x: b.cx + bodyX * 0.85, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 0.85, y: b.sightY + 0.1, z: atT() },
          ]),
          mass('ink', [
            { x: b.cx - armX - 0.015, y: shoulderY + 0.06, z: atT() },
            { x: b.cx - armX + 0.02, y: shoulderY + 0.06, z: atT() },
            { x: b.cx - armX * 0.85, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - armX - 0.02, y: b.sightY + 0.1, z: atT() },
          ]),
          mass('ink', [
            { x: b.cx + armX - 0.02, y: shoulderY + 0.06, z: atT() },
            { x: b.cx + armX + 0.02, y: shoulderY + 0.06, z: atT() },
            { x: b.cx + armX + 0.02, y: b.sightY + 0.1, z: atT() },
            { x: b.cx + armX * 0.85, y: b.sightY + 0.1, z: atT() },
          ]),
        ];
      },
    },
    // 4. Render entourage: the watercolour person every architectural
    // drawing scatters for scale — a hunched coat with a cowl, soft edges,
    // no face, leaning into its own business.
    {
      name: 'entourage',
      w: 0.44,
      h: 1.38,
      draw: (s) => {
        const b = base(s, 1.38);
        const lean = b.cx - 0.03;
        const headR = 0.075;
        const headCY = b.crownY + headR * 1.2;
        const cowlTop = headCY + headR * 0.8;
        return [
          mass('fabric', circ(lean, headCY, headR)),
          mass('fabric', [
            { x: lean - 0.155, y: cowlTop + 0.09, z: atT() },
            { x: lean + 0.12, y: cowlTop + 0.04, z: atT() },
            { x: lean + 0.19, y: b.sightY + 0.1, z: atT() },
            { x: lean - 0.2, y: b.sightY + 0.12, z: atT() },
          ]),
          mass('fabric', [
            { x: lean - 0.185, y: cowlTop + 0.02, z: atT() },
            { x: lean - 0.09, y: cowlTop - 0.075, z: atT() },
            { x: lean + 0.02, y: cowlTop - 0.02, z: atT() },
            { x: lean - 0.05, y: cowlTop + 0.07, z: atT() },
          ]),
        ];
      },
    },
    // 5. The Bauhaus instruction figure: a circle-head outline, straight
    // tube arms, a filled torso — the assembly-diagram person.
    {
      name: 'bauhaus',
      w: 0.4,
      h: 1.3,
      draw: (s) => {
        const b = base(s, 1.3);
        const headR = 0.08;
        const headCY = b.crownY + headR;
        const shoulderY = headCY + headR + 0.015;
        const bodyX = 0.115;
        return [
          stroke('ink', circ(b.cx, headCY, headR, 16), 'bauhaus-head', WEIGHTS.outline),
          mass('ink', [
            { x: b.cx - bodyX, y: shoulderY, z: atT() },
            { x: b.cx + bodyX, y: shoulderY, z: atT() },
            { x: b.cx + bodyX * 0.9, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 0.9, y: b.sightY + 0.1, z: atT() },
          ]),
          stroke(
            'ink',
            [
              { x: b.cx - bodyX * 0.9, y: shoulderY + 0.01, z: atT() },
              { x: b.cx - bodyX * 1.5, y: shoulderY + 0.1, z: atT() },
              { x: b.cx - bodyX * 1.35, y: shoulderY + 0.26, z: atT() },
            ],
            'bauhaus-armL',
            WEIGHTS.outline,
          ),
          stroke(
            'ink',
            [
              { x: b.cx + bodyX * 0.9, y: shoulderY + 0.01, z: atT() },
              { x: b.cx + bodyX * 1.5, y: shoulderY + 0.1, z: atT() },
              { x: b.cx + bodyX * 1.35, y: shoulderY + 0.26, z: atT() },
            ],
            'bauhaus-armR',
            WEIGHTS.outline,
          ),
        ];
      },
    },
    // 6. The pictogram: the AIGA-sign person — a detached round head over
    // the rounded-shoulder tapered body, read at a glance from a car.
    {
      name: 'pictogram',
      w: 0.38,
      h: 1.25,
      draw: (s) => {
        const b = base(s, 1.25);
        const headR = 0.085;
        const headCY = b.crownY + headR;
        const bodyTop = headCY + headR * 1.7;
        const bodyX = 0.145;
        return [
          mass('ink', circ(b.cx, headCY, headR)),
          mass('ink', [
            { x: b.cx - bodyX * 0.55, y: bodyTop, z: atT() },
            { x: b.cx + bodyX * 0.55, y: bodyTop, z: atT() },
            { x: b.cx + bodyX, y: bodyTop + 0.045, z: atT() },
            { x: b.cx + bodyX * 0.78, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 0.78, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX, y: bodyTop + 0.045, z: atT() },
          ]),
        ];
      },
    },
    // 7. The Tokyo-night silhouette: the back-lit resident against the warm
    // room — dark hair and shoulders over the lamp's pool of light.
    {
      name: 'heimetric',
      w: 0.46,
      h: 1.35,
      draw: (s, hair) => {
        const b = base(s, 1.35);
        const headR = 0.085;
        const headCY = b.crownY + headR * 1.2;
        const neckW = 0.035;
        const shoulderY = headCY + headR + 0.045;
        const bodyX = 0.175;
        return [
          mass('ambient', circ(b.cx, headCY + 0.02, headR * 2.4, 18)),
          mass('ambient', [
            { x: b.cx - bodyX * 1.9, y: shoulderY - 0.01, z: atT() },
            { x: b.cx + bodyX * 1.9, y: shoulderY - 0.01, z: atT() },
            { x: b.cx + bodyX * 1.6, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 1.6, y: b.sightY + 0.1, z: atT() },
          ]),
          mass('ink', circ(b.cx, headCY, headR)),
          mass('ink', [
            { x: b.cx - neckW, y: headCY + headR * 0.5, z: atT() },
            { x: b.cx + neckW, y: headCY + headR * 0.5, z: atT() },
            { x: b.cx + neckW * 1.5, y: shoulderY + 0.02, z: atT() },
            { x: b.cx - neckW * 1.5, y: shoulderY + 0.02, z: atT() },
          ]),
          mass('ink', [
            { x: b.cx - bodyX, y: shoulderY + 0.05, z: atT() },
            { x: b.cx + bodyX, y: shoulderY + 0.05, z: atT() },
            { x: b.cx + bodyX * 0.92, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 0.92, y: b.sightY + 0.1, z: atT() },
          ]),
          ...hairBlob('ink', b.cx, headCY, headR, hair),
        ];
      },
    },
    // 8. The Matisse cut-out: the body as one organic paper shape — curved
    // asymmetric shoulder, swayed hip, the head fused on without a neck.
    {
      name: 'matisse',
      w: 0.42,
      h: 1.32,
      draw: (s) => {
        const b = base(s, 1.32);
        const headR = 0.075;
        const headCY = b.crownY + headR * 1.1;
        const sway = 0.025;
        const shoulderY = headCY + headR * 1.15;
        return [
          mass('ink', ellipse(b.cx + 0.012, headCY, headR * 0.92, headR)),
          mass('ink', [
            { x: b.cx - 0.115, y: shoulderY + 0.02, z: atT() },
            { x: b.cx + 0.14, y: shoulderY - 0.01, z: atT() },
            { x: b.cx + 0.185, y: shoulderY + 0.18, z: atT() },
            { x: b.cx + 0.16 + sway, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - 0.13 + sway, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - 0.185, y: shoulderY + 0.22, z: atT() },
          ]),
        ];
      },
    },
    // 9. The Sempé figure: a small, sparse ink line person — a circle head,
    // two quick shoulder strokes, one hat brim — lost in the big quiet pane.
    {
      name: 'sempe',
      w: 0.36,
      h: 1.15,
      draw: (s) => {
        const b = base(s, 1.15);
        const headR = 0.055;
        const headCY = b.crownY + headR * 1.35;
        const shoulderY = headCY + headR + 0.05;
        const bodyX = 0.1;
        return [
          stroke('ink', circ(b.cx, headCY, headR, 14), 'sempe-head', WEIGHTS.outline),
          stroke(
            'ink',
            [
              { x: b.cx - headR * 1.7, y: headCY - headR * 0.55, z: atT() },
              { x: b.cx, y: headCY - headR * 1.15, z: atT() },
              { x: b.cx + headR * 1.9, y: headCY - headR * 0.45, z: atT() },
            ],
            'sempe-brim',
            WEIGHTS.outline,
          ),
          stroke(
            'ink',
            [
              { x: b.cx - bodyX, y: b.sightY + 0.1, z: atT() },
              { x: b.cx - bodyX * 0.9, y: shoulderY + 0.02, z: atT() },
              { x: b.cx, y: shoulderY, z: atT() },
              { x: b.cx + bodyX * 0.9, y: shoulderY + 0.02, z: atT() },
              { x: b.cx + bodyX, y: b.sightY + 0.1, z: atT() },
            ],
            'sempe-body',
            WEIGHTS.outline,
          ),
        ];
      },
    },
    // 10. Folk flat: the picture-book resident — a pale flat body, solid ink
    // hair blob, two quiet dot eyes, frontal and unbothered.
    {
      name: 'folk',
      w: 0.44,
      h: 1.32,
      draw: (s, hair) => {
        const b = base(s, 1.32);
        const headR = 0.088;
        const headCY = b.crownY + headR * 1.2;
        const shoulderY = headCY + headR + 0.04;
        const bodyX = 0.16;
        return [
          mass('fabric', [
            { x: b.cx - bodyX * 0.6, y: shoulderY - 0.01, z: atT() },
            { x: b.cx + bodyX * 0.6, y: shoulderY - 0.01, z: atT() },
            { x: b.cx + bodyX, y: shoulderY + 0.05, z: atT() },
            { x: b.cx + bodyX * 0.9, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 0.9, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX, y: shoulderY + 0.05, z: atT() },
          ]),
          mass('ink', circ(b.cx, headCY, headR)),
          ...hairBlob('ink', b.cx, headCY, headR, hair),
          dot('ink', { x: b.cx - headR * 0.42, y: headCY + headR * 0.05 }, headR * 0.12, 'folk-eyeL'),
          dot('ink', { x: b.cx + headR * 0.42, y: headCY + headR * 0.05 }, headR * 0.12, 'folk-eyeR'),
        ];
      },
    },
  ];

  const KINDS_SHEET_COLS = 3;
  const STRIP_COLS = 5;

  function fit(box: { width: number; height: number; dpr: number }, cols: number, rows: number) {
    const scale = Math.min(box.width / (cols * UNIT_PITCH_X), box.height / (rows * UNIT_PITCH_Y));
    return { scale: box.dpr * scale, cx: (box.width * box.dpr) / 2, cy: (box.height * box.dpr) / 2 };
  }

  function plateOrigin(g: ReturnType<typeof fit>, i: number, cols: number, rows: number) {
    const ox = ((i % cols) - (cols - 1) / 2) * UNIT_PITCH_X;
    const oy = (Math.floor(i / cols) - (rows - 1) / 2) * UNIT_PITCH_Y;
    return { ox, oy };
  }

  function pointerEye(): (canvas: HTMLCanvasElement) => { x: number; y: number } {
    const pointer = { x: 0, y: 0 };
    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX / window.innerWidth - 0.5;
      pointer.y = e.clientY / window.innerHeight - 0.5;
    });
    return () => ({ ...pointer });
  }

  const labelFont = `${getComputedStyle(document.body).getPropertyValue('--typography-body2-fontFamily').trim() || 'sans-serif'}`;

  // One window scene per style: shell, a pinned coat stand opposite the
  // lamp — the size anchor — the tenant centred on its plane, sill. No
  // curtain: a rolled curtain would cover the figure it sits behind.
  function humanPlate(c: Candidate, seed: number, i: number, theme: Theme, time: number, ctx: CanvasRenderingContext2D): void {
    const pen = new Pen({ ...DEFAULT_TUNING }, windowSeed(seed, i, 0));
    pen.setTime(time);
    const plan = expandShell(pen.seed);
    const opening: PaneRect = innerRect(plan.faceWidth);
    const rng = fork(pen.seed, 'dna');
    const sill = sillMarks(rng, opening);
    const lamp = pinnedLamp({ location: i % 2 === 0 ? 'innerRight' : 'innerLeft' });
    const hair = rollHair(seed, i);
    const room = roomOf(opening);
    const cx = (opening.left + opening.right) / 2;
    const x0 = cx - c.w / 2;
    const spot: Spot = { x0, x1: x0 + c.w, floorY: room.bottom, topY: room.bottom - c.h, w: c.w, h: c.h };
    execute(
      [
        ...shellMarks(plan),
        ...drawFurniture({ pieces: [{ kind: 'coatStand', plane: 4, side: lamp.location === 'innerRight' ? 'left' : 'right' }] }, opening),
        ...lampMarks(lamp, opening, theme.isNight),
        ...c.draw(spot, hair),
        ...sill,
      ],
      pen,
      ctx,
      windowPalette(pen.seed, theme),
      makeProjection({ x: 0, y: 0 }),
      opening,
    );
  }

  function mountKinds(canvas: HTMLCanvasElement, label: HTMLSpanElement, button: HTMLButtonElement): void {
    let seed = rollSeed();
    const show = () => (label.textContent = `seed ${seed}`);
    show();
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme) => {
        const box = cssBox(canvas);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        // ?kind=<name> collapses the sheet to one huge plate — the close
        // look without a screenshot slicer.
        const one = new URLSearchParams(window.location.search).get('kind');
        const shown = CANDIDATES.filter((c) => !one || c.name === one);
        const cols = one ? shown.length : KINDS_SHEET_COLS;
        const rws = Math.ceil(shown.length / cols);
        const g = fit(box, cols, rws);
        ctx.setTransform(g.scale, 0, 0, g.scale, g.cx, g.cy);
        shown.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, cols, rws);
          ctx.save();
          ctx.translate(ox, oy);
          humanPlate(c, seed, i, theme, time, ctx);
          ctx.restore();
        });
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.ink;
        ctx.globalAlpha = 0.75;
        ctx.font = `${Math.max(10, 0.16 * g.scale)}px ${labelFont}`;
        ctx.textAlign = 'center';
        shown.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, cols, rws);
          ctx.fillText(c.name, g.cx + ox * g.scale, g.cy + oy * g.scale + 0.82 * g.scale);
        });
        ctx.globalAlpha = 1;
      },
      pointerEye(),
    );
    button.addEventListener('click', () => {
      seed = rollSeed();
      show();
    });
  }

  function mountStrip(canvas: HTMLCanvasElement): void {
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme) => {
        const box = cssBox(canvas);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        const rows = Math.ceil(CANDIDATES.length / STRIP_COLS);
        const g = fit(box, STRIP_COLS, rows);
        ctx.setTransform(g.scale, 0, 0, g.scale, g.cx, g.cy);
        CANDIDATES.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, STRIP_COLS, rows);
          ctx.save();
          ctx.translate(ox, oy);
          humanPlate(c, 424242, i, theme, time, ctx);
          ctx.restore();
        });
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.ink;
        ctx.globalAlpha = 0.75;
        ctx.font = `${Math.max(9, 0.14 * g.scale)}px ${labelFont}`;
        ctx.textAlign = 'center';
        CANDIDATES.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, STRIP_COLS, rows);
          ctx.fillText(c.name, g.cx + ox * g.scale, g.cy + oy * g.scale + 1.02 * g.scale);
        });
        ctx.globalAlpha = 1;
      },
      pointerEye(),
    );
  }

  const el = (id: string) => document.getElementById(id)!;
  mountKinds(el('kinds') as HTMLCanvasElement, el('kinds-seed'), el('kinds-reseed') as HTMLButtonElement);
  mountStrip(el('strip') as HTMLCanvasElement);
</script>
