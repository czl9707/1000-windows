---
import BaseLayout from '@/components/layouts/BaseLayout.astro';
---

<BaseLayout title="Human bench">
  <main>
    <h1>Human bench</h1>
    <p>
      Prototype, throwaway, round four: ten illustration styles of drawing
      the tenant, each built on a named reference's actual vocabulary — the
      Notion marketing illustrations (line-drawn body, selective solid-black
      masses, closed-eye face, props), Jean Jullien's thick single-outline
      figures with dot eyes, Quentin Blake's scratchy double-scratch ink with
      a wash over, Ludwig Bemelmans' elegant small hats-and-coats line, Jon
      Klassen's muted sober flats, Tatsuro Kiuchi's collared coats, the
      Tokyo-night back-lit silhouette, the Matisse cut-out, the AIGA
      pictogram, a Sempé ink figure. Full figures — head and face, torso,
      arms, hips, props — standing at the glass; the body keeps the
      furniture's own compressed scale, 1.2–1.4 units against the coat
      stand's 1.4. The sheet gives every style one large plate; the strip
      shows the same windows at street density. Daylight pinned; the button
      re-rolls in place.
    </p>

    <section>
      <h2>The styles</h2>
      <canvas id="kinds" width="900" height="1500"></canvas>
      <button id="kinds-reseed" type="button">New sheet</button>
      <span id="kinds-seed"></span>
    </section>

    <section>
      <h2>The street strip</h2>
      <canvas id="strip" width="900" height="290"></canvas>
      <p>Same windows, five to a row at half pitch — the far-wall density.</p>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }
  canvas {
    width: 100%;
    height: auto;
    display: block;
    border: var(--border);
  }
  section {
    margin-bottom: 2rem;
  }
</style>

<script>
  // PROTOTYPE, throwaway: candidate styles for the tenant silhouette,
  // drawn as marks into a real window scene. The style the eye picks
  // graduates into the occupant layer; this page does not survive the
  // milestone.
  import { createDemoLoop, cssBox } from '@/components/demoLoop';
  import { Pen } from '@/pen/pen';
  import { DEFAULT_TUNING } from '@/pen/tuning';
  import { rollSeed } from '@/components/mount';
  import type { Theme, ColorRole } from '@/styling/roles';
  import { WEIGHTS } from '@/styling/weights';
  import { windowPalette } from '@/styling/colourway';
  import { fork, windowSeed } from '@/core/randomness/rng';
  import { execute, type Mark } from '@/core/scene';
  import { shellMarks, expandShell } from '@/core/window-shell';
  import { innerRect, type PaneRect } from '@/core/window-shell/shell';
  import { sillMarks } from '@/core/sill';
  import { pinnedLamp } from '@/core/light/light';
  import { lampMarks } from '@/core/light/drawLamp';
  import type { Pt3 } from '@/motion/projection';
  import { roomOf } from '@/core/furniture/room';
  import { drawFurniture } from '@/core/furniture/drawFurniture';
  import { makeProjection } from '@/motion/projection';

  const UNIT_PITCH_X = 2.3;
  const UNIT_PITCH_Y = 1.8;

  // Daylight pinned: the interior judges best with the lamps dark.
  document.body.setAttribute('data-theme', 'light');

  // The tenant stands on the room floor at a furniture plane — a resident
  // among the pieces, not a giant glued to the glass.
  const TENANT_DEPTH = -0.15;
  const TENANT_Z = -8.8;
  const atT = () => TENANT_DEPTH;
  const zT = () => TENANT_Z;

  interface Spot {
    x0: number;
    x1: number;
    floorY: number;
    topY: number;
    w: number;
    h: number;
  }

  interface Candidate {
    name: string;
    w: number;
    h: number;
    draw: (s: Spot, hair: Hair) => Mark[];
  }

  const mass = (role: ColorRole, pts: Pt3[]): Mark => ({ kind: 'fill', pts, role, z: zT() });
  const stroke = (role: ColorRole, pts: Pt3[], name: string, widthUnits: number): Mark => ({
    kind: 'stroke',
    pts,
    name,
    widthUnits,
    role,
    z: zT(),
  });
  const dot = (role: ColorRole, p: { x: number; y: number }, r: number, name: string): Mark => ({
    kind: 'dot',
    pts: [{ x: p.x, y: p.y, z: atT() }],
    role,
    z: zT(),
    name,
    r,
  });
  const cxOf = (s: Spot) => (s.x0 + s.x1) / 2;

  // Where every tenant meets its room: the x centre with its per-window
  // drift, the floor, the sightline the aperture cuts at.
  function base(s: Spot, height: number) {
    const sightY = s.floorY - 0.85;
    return {
      cx: cxOf(s) + 0.012 * s.h * Math.sin(s.x0 * 9.1),
      crownY: s.floorY - height,
      floorY: s.floorY,
      sightY,
    };
  }

  function ellipse(cx: number, cy: number, rx: number, ry: number, n = 16): Pt3[] {
    const pts: Pt3[] = [];
    for (let i = 0; i < n; i++) {
      const a = (i / n) * Math.PI * 2;
      pts.push({ x: cx + Math.cos(a) * rx, y: cy + Math.sin(a) * ry, z: atT() });
    }
    return pts;
  }

  const circ = (cx: number, cy: number, r: number, n = 14) => ellipse(cx, cy, r, r, n);

  type Hair = 'crop' | 'bun' | 'curls' | 'sidePart';

  function rollHair(seed: number, i: number): Hair {
    const r = fork(windowSeed(seed, i, 0), 'tenant-hair');
    return r.weighted([
      { value: 'crop' as const, weight: 3 },
      { value: 'bun' as const, weight: 2 },
      { value: 'curls' as const, weight: 2 },
      { value: 'sidePart' as const, weight: 2 },
    ]);
  }

  // A hair blob over a head circle: the outline above the skull is where a
  // person stops being an egg (the reference's frisur layer).
  function hairBlob(role: ColorRole, cx: number, headCY: number, headR: number, hair: Hair): Mark[] {
    const marks: Mark[] = [];
    const capY = headCY - headR * 0.35;
    if (hair === 'crop' || hair === 'sidePart') {
      const shift = hair === 'sidePart' ? headR * 0.3 : 0;
      marks.push(mass(role, ellipse(cx + shift, capY, headR * 1.1, headR * 1.02)));
    } else if (hair === 'curls') {
      for (const off of [-0.7, -0.2, 0.3, 0.75]) {
        marks.push(mass(role, circ(cx + off * headR * 1.1, capY - headR * 0.3 + Math.abs(off) * headR * 0.35, headR * 0.45)));
      }
    } else {
      marks.push(mass(role, ellipse(cx, capY, headR * 1.1, headR * 1.02)));
      marks.push(mass(role, circ(cx + headR * 0.6, headCY - headR * 1.15, headR * 0.42)));
    }
    return marks;
  }

  const CANDIDATES: Candidate[] = [
    // 1. The Notion marketing illustration: the body line-drawn in one even
    // contour with fold lines on the shirt, the hair and the trousers as
    // solid black masses, the eyes closed, a mug in the hand — straight off
    // the getillustrations Notion sheet.
    {
      name: 'notion',
      w: 0.5,
      h: 1.38,
      draw: (s) => {
        const b = base(s, 1.38);
        const headR = 0.095;
        const headCY = b.crownY + headR * 1.35;
        const chinY = headCY + headR;
        const shoulderY = chinY + 0.05;
        const waistY = shoulderY + (b.sightY - shoulderY) * 0.55;
        const bodyX = 0.145;
        const handX = b.cx + bodyX * 1.05;
        const handY = waistY - 0.06;
        const marks: Mark[] = [
          // The head: an even contour, the face left open under the hair.
          stroke('ink', ellipse(b.cx, headCY, headR * 0.88, headR, 18), 'notion-head', WEIGHTS.outline),
          // Closed eyes, nose, mouth — the whole Notion face is three
          // curves and a dot.
          stroke(
            'ink',
            [
              { x: b.cx - headR * 0.45, y: headCY - headR * 0.05, z: atT() },
              { x: b.cx - headR * 0.25, y: headCY + headR * 0.1, z: atT() },
              { x: b.cx - headR * 0.02, y: headCY - headR * 0.05, z: atT() },
            ],
            'notion-eye',
            WEIGHTS.detail,
          ),
          stroke(
            'ink',
            [
              { x: b.cx + headR * 0.08, y: headCY + headR * 0.32, z: atT() },
              { x: b.cx + headR * 0.16, y: headCY + headR * 0.42, z: atT() },
            ],
            'notion-nose',
            WEIGHTS.detail,
          ),
          stroke(
            'ink',
            [
              { x: b.cx - headR * 0.08, y: headCY + headR * 0.62, z: atT() },
              { x: b.cx + headR * 0.12, y: headCY + headR * 0.62, z: atT() },
            ],
            'notion-mouth',
            WEIGHTS.detail,
          ),
          // The shirt: a closed contour — shoulders, sleeve tops, sides,
          // hem — with two fold lines on the chest.
          stroke(
            'ink',
            [
              { x: b.cx - bodyX * 0.35, y: shoulderY - 0.005, z: atT() },
              { x: b.cx - bodyX * 0.85, y: shoulderY + 0.02, z: atT() },
              { x: b.cx - bodyX * 0.95, y: shoulderY + 0.07, z: atT() },
              { x: b.cx - bodyX * 0.85, y: shoulderY + 0.12, z: atT() },
              { x: b.cx - bodyX * 0.9, y: shoulderY + (waistY - shoulderY) * 0.5, z: atT() },
              { x: b.cx - bodyX * 0.72, y: waistY, z: atT() },
              { x: b.cx + bodyX * 0.68, y: waistY, z: atT() },
              { x: b.cx + bodyX * 0.9, y: shoulderY + (waistY - shoulderY) * 0.5, z: atT() },
              { x: b.cx + bodyX * 0.95, y: shoulderY + 0.07, z: atT() },
              { x: b.cx + bodyX * 0.6, y: shoulderY - 0.005, z: atT() },
            ],
            'notion-shirt',
            WEIGHTS.outline,
          ),
          stroke(
            'ink',
            [
              { x: b.cx - bodyX * 0.68, y: waistY, z: atT() },
              { x: b.cx + bodyX * 0.68, y: waistY, z: atT() },
            ],
            'notion-hem',
            WEIGHTS.outline,
          ),
          stroke(
            'ink',
            [
              { x: b.cx - bodyX * 0.3, y: shoulderY + 0.05, z: atT() },
              { x: b.cx - bodyX * 0.35, y: shoulderY + 0.13, z: atT() },
            ],
            'notion-fold1',
            WEIGHTS.detail,
          ),
          stroke(
            'ink',
            [
              { x: b.cx + bodyX * 0.22, y: shoulderY + 0.06, z: atT() },
              { x: b.cx + bodyX * 0.2, y: shoulderY + 0.15, z: atT() },
            ],
            'notion-fold2',
            WEIGHTS.detail,
          ),
          // The left arm hangs inside its sleeve; the right bends forward,
          // mug in the hand.
          stroke(
            'ink',
            [
              { x: b.cx - bodyX * 0.72, y: shoulderY + 0.05, z: atT() },
              { x: b.cx - bodyX * 0.88, y: shoulderY + 0.12, z: atT() },
              { x: b.cx - bodyX * 0.8, y: waistY - 0.02, z: atT() },
            ],
            'notion-armL',
            WEIGHTS.outline,
          ),
          stroke(
            'ink',
            [
              { x: b.cx + bodyX * 0.66, y: shoulderY + 0.05, z: atT() },
              { x: handX - 0.015, y: shoulderY + 0.12, z: atT() },
              { x: handX - 0.01, y: handY + 0.05, z: atT() },
            ],
            'notion-armR',
            WEIGHTS.outline,
          ),
          mass('ink', [
            { x: handX - 0.032, y: handY - 0.055, z: atT() },
            { x: handX + 0.032, y: handY - 0.055, z: atT() },
            { x: handX + 0.028, y: handY, z: atT() },
            { x: handX - 0.028, y: handY, z: atT() },
          ]),
          stroke(
            'ink',
            [
              { x: handX + 0.03, y: handY - 0.045, z: atT() },
              { x: handX + 0.058, y: handY - 0.04, z: atT() },
              { x: handX + 0.056, y: handY - 0.015, z: atT() },
              { x: handX + 0.03, y: handY - 0.012, z: atT() },
            ],
            'notion-mugHandle',
            WEIGHTS.detail,
          ),
          // The trousers: one solid black mass to the sightline.
          mass('ink', [
            { x: b.cx - bodyX * 0.66, y: waistY - 0.01, z: atT() },
            { x: b.cx + bodyX * 0.66, y: waistY - 0.01, z: atT() },
            { x: b.cx + bodyX * 0.58, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 0.58, y: b.sightY + 0.1, z: atT() },
          ]),
        ];
        // The hair last: a solid black cap wrapping down past the ears, the
        // bun on top — no flying strand, this tenant stands still.
        marks.push(
          mass('ink', ellipse(b.cx, headCY - headR * 0.42, headR * 1.02, headR * 0.72)),
          mass('ink', circ(b.cx - headR * 0.08, headCY - headR * 1.3, headR * 0.36)),
        );
        return marks;
      },
    },
    // 2. Jean Jullien: everything drawn twice — the outline once, heavy and
    // even; dot eyes and a smile; the hair alone carries black.
    {
      name: 'jullien',
      w: 0.48,
      h: 1.35,
      draw: (s, hair) => {
        const b = base(s, 1.35);
        const headR = 0.095;
        const headCY = b.crownY + headR * 1.3;
        const shoulderY = headCY + headR + 0.01;
        const bodyX = 0.15;
        return [
          stroke('ink', ellipse(b.cx, headCY, headR, headR, 20), 'jullien-head', WEIGHTS.outline),
          dot('ink', { x: b.cx - headR * 0.4, y: headCY - headR * 0.05 }, headR * 0.11, 'jullien-eyeL'),
          dot('ink', { x: b.cx + headR * 0.4, y: headCY - headR * 0.05 }, headR * 0.11, 'jullien-eyeR'),
          stroke(
            'ink',
            [
              { x: b.cx - headR * 0.22, y: headCY + headR * 0.4, z: atT() },
              { x: b.cx, y: headCY + headR * 0.52, z: atT() },
              { x: b.cx + headR * 0.22, y: headCY + headR * 0.4, z: atT() },
            ],
            'jullien-smile',
            WEIGHTS.outline,
          ),
          stroke(
            'ink',
            [
              { x: b.cx - bodyX * 0.6, y: shoulderY, z: atT() },
              { x: b.cx - bodyX * 0.85, y: shoulderY + 0.08, z: atT() },
              { x: b.cx - bodyX * 0.8, y: shoulderY + 0.22, z: atT() },
              { x: b.cx - bodyX * 0.88, y: shoulderY + 0.34, z: atT() },
              { x: b.cx - bodyX * 0.72, y: b.sightY + 0.1, z: atT() },
              { x: b.cx + bodyX * 0.72, y: b.sightY + 0.1, z: atT() },
              { x: b.cx + bodyX * 0.88, y: shoulderY + 0.34, z: atT() },
              { x: b.cx + bodyX * 0.8, y: shoulderY + 0.22, z: atT() },
              { x: b.cx + bodyX * 0.85, y: shoulderY + 0.08, z: atT() },
              { x: b.cx + bodyX * 0.6, y: shoulderY, z: atT() },
            ],
            'jullien-body',
            WEIGHTS.outline,
          ),
          // The hair: a small black crown cap with the bun — the face stays
          // wide open, Jullien's faces do all the talking.
          mass('ink', ellipse(b.cx, headCY - headR * 0.62, headR * 0.82, headR * 0.42)),
          mass('ink', circ(b.cx, headCY - headR * 1.05, headR * 0.24)),
        ];
      },
    },
    // 3. Quentin Blake: every contour scratched twice — two thin strokes
    // under separate trace names, so the hand doubles over itself — the
    // coat washed flat over the scratch, one long nose, hair as scribble.
    {
      name: 'blake',
      w: 0.46,
      h: 1.4,
      draw: (s) => {
        const b = base(s, 1.4);
        const lean = b.cx + 0.035;
        const headR = 0.078;
        const headCY = b.crownY + headR * 1.25;
        const shoulderY = headCY + headR + 0.03;
        const scratch = (pts: Pt3[], name: string): Mark[] => [
          stroke('ink', pts, `${name}-a`, WEIGHTS.detail),
          stroke('ink', pts, `${name}-b`, WEIGHTS.detail),
        ];
        return [
          ...scratch(
            [
              { x: lean - 0.01, y: headCY - headR, z: atT() },
              { x: lean - headR * 0.8, y: headCY - headR * 0.3, z: atT() },
              { x: lean - headR * 0.85, y: headCY + headR * 0.4, z: atT() },
              { x: lean - headR * 0.4, y: headCY + headR, z: atT() },
              { x: lean + headR * 0.5, y: headCY + headR * 0.95, z: atT() },
              { x: lean + headR * 0.9, y: headCY + headR * 0.2, z: atT() },
              { x: lean + headR * 0.75, y: headCY - headR * 0.5, z: atT() },
              { x: lean + 0.01, y: headCY - headR * 1.02, z: atT() },
            ],
            'blake-head',
          ),
          stroke(
            'ink',
            [
              { x: lean + headR * 0.5, y: headCY + headR * 0.25, z: atT() },
              { x: lean + headR * 0.95, y: headCY + headR * 0.4, z: atT() },
              { x: lean + headR * 1.25, y: headCY + headR * 0.32, z: atT() },
            ],
            'blake-nose',
            WEIGHTS.detail,
          ),
          ...scratch(
            [
              { x: lean - 0.11, y: shoulderY, z: atT() },
              { x: lean - 0.16, y: shoulderY + 0.12, z: atT() },
              { x: lean - 0.12, y: shoulderY + 0.26, z: atT() },
              { x: lean - 0.15, y: b.sightY + 0.1, z: atT() },
              { x: lean + 0.16, y: b.sightY + 0.1, z: atT() },
              { x: lean + 0.13, y: shoulderY + 0.2, z: atT() },
              { x: lean + 0.12, y: shoulderY + 0.02, z: atT() },
            ],
            'blake-coat',
          ),
          mass('fabric', [
            { x: lean - 0.12, y: shoulderY + 0.02, z: atT() },
            { x: lean + 0.13, y: shoulderY + 0.02, z: atT() },
            { x: lean + 0.15, y: b.sightY + 0.1, z: atT() },
            { x: lean - 0.14, y: b.sightY + 0.1, z: atT() },
          ]),
          ...scratch(
            [
              { x: lean + 0.12, y: shoulderY + 0.05, z: atT() },
              { x: lean + 0.24, y: shoulderY + 0.16, z: atT() },
              { x: lean + 0.28, y: shoulderY + 0.3, z: atT() },
            ],
            'blake-arm',
          ),
          ...scratch(
            [
              { x: lean - headR * 0.9, y: headCY - headR * 0.85, z: atT() },
              { x: lean - headR * 0.3, y: headCY - headR * 1.35, z: atT() },
              { x: lean + headR * 0.4, y: headCY - headR * 1.15, z: atT() },
              { x: lean + headR * 0.85, y: headCY - headR * 0.7, z: atT() },
            ],
            'blake-hair',
          ),
        ];
      },
    },
    // 4. Ludwig Bemelmans: the elegant small Parisian — beret tilted, long
    // coat with button dots, hands clasped behind, everything one calm
    // medium line.
    {
      name: 'bemelmans',
      w: 0.4,
      h: 1.2,
      draw: (s) => {
        const b = base(s, 1.2);
        const headR = 0.072;
        const headCY = b.crownY + headR * 1.5;
        const shoulderY = headCY + headR + 0.025;
        const bodyX = 0.12;
        return [
          mass('ink', ellipse(b.cx + 0.01, b.crownY + headR * 0.42, headR * 1.15, headR * 0.5)),
          stroke('ink', ellipse(b.cx, headCY, headR * 0.82, headR, 16), 'bemelmans-head', WEIGHTS.outline),
          dot('ink', { x: b.cx - headR * 0.3, y: headCY - headR * 0.02 }, headR * 0.1, 'bemelmans-eyeL'),
          dot('ink', { x: b.cx + headR * 0.3, y: headCY - headR * 0.02 }, headR * 0.1, 'bemelmans-eyeR'),
          stroke(
            'ink',
            [
              { x: b.cx - bodyX * 0.55, y: shoulderY, z: atT() },
              { x: b.cx - bodyX * 0.8, y: shoulderY + 0.14, z: atT() },
              { x: b.cx - bodyX * 0.72, y: b.sightY + 0.1, z: atT() },
              { x: b.cx + bodyX * 0.72, y: b.sightY + 0.1, z: atT() },
              { x: b.cx + bodyX * 0.8, y: shoulderY + 0.14, z: atT() },
              { x: b.cx + bodyX * 0.55, y: shoulderY, z: atT() },
            ],
            'bemelmans-coat',
            WEIGHTS.outline,
          ),
          stroke(
            'ink',
            [
              { x: b.cx - bodyX * 0.62, y: shoulderY + 0.01, z: atT() },
              { x: b.cx - bodyX * 0.3, y: shoulderY + 0.03, z: atT() },
              { x: b.cx + bodyX * 0.05, y: shoulderY + 0.01, z: atT() },
            ],
            'bemelmans-lapel',
            WEIGHTS.detail,
          ),
          dot('ink', { x: b.cx - bodyX * 0.1, y: shoulderY + 0.16 }, 0.008, 'bemelmans-btn1'),
          dot('ink', { x: b.cx - bodyX * 0.1, y: shoulderY + 0.26 }, 0.008, 'bemelmans-btn2'),
        ];
      },
    },
    // 5. Jon Klassen: the muted sober flat — dark square-ish sweater with
    // the arms sealed in, a pale face under a flat dark cap, two dot eyes,
    // a straight mouth. Nothing gestures.
    {
      name: 'klassen',
      w: 0.44,
      h: 1.3,
      draw: (s) => {
        const b = base(s, 1.3);
        const headR = 0.082;
        const headCY = b.crownY + headR * 1.3;
        const shoulderY = headCY + headR + 0.02;
        const bodyX = 0.155;
        return [
          mass('paper', ellipse(b.cx, headCY, headR * 0.8, headR * 0.92, 16)),
          mass('ink', [
            { x: b.cx - headR * 0.85, y: headCY - headR * 0.05, z: atT() },
            { x: b.cx + headR * 0.85, y: headCY - headR * 0.05, z: atT() },
            { x: b.cx + headR * 0.8, y: headCY - headR * 0.8, z: atT() },
            { x: b.cx - headR * 0.8, y: headCY - headR * 0.8, z: atT() },
          ]),
          mass('ink', circ(b.cx - headR * 0.05, headCY - headR * 0.95, headR * 0.6)),
          mass('ink', [
            { x: b.cx - bodyX * 0.8, y: shoulderY, z: atT() },
            { x: b.cx + bodyX * 0.8, y: shoulderY, z: atT() },
            { x: b.cx + bodyX, y: shoulderY + 0.07, z: atT() },
            { x: b.cx + bodyX * 0.88, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 0.88, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX, y: shoulderY + 0.07, z: atT() },
          ]),
          dot('ink', { x: b.cx - headR * 0.3, y: headCY + headR * 0.05 }, headR * 0.12, 'klassen-eyeL'),
          dot('ink', { x: b.cx + headR * 0.3, y: headCY + headR * 0.05 }, headR * 0.12, 'klassen-eyeR'),
          stroke(
            'ink',
            [
              { x: b.cx - headR * 0.16, y: headCY + headR * 0.45, z: atT() },
              { x: b.cx + headR * 0.16, y: headCY + headR * 0.45, z: atT() },
            ],
            'klassen-mouth',
            WEIGHTS.detail,
          ),
        ];
      },
    },
    // 6. Tatsuro Kiuchi: the flat muted coat — collar up, cap pulled low,
    // hands in the pockets, the face just a nose stroke over the paper.
    {
      name: 'kiuchi',
      w: 0.44,
      h: 1.36,
      draw: (s) => {
        const b = base(s, 1.36);
        const headR = 0.078;
        const headCY = b.crownY + headR * 1.4;
        const shoulderY = headCY + headR + 0.015;
        const bodyX = 0.15;
        return [
          mass('paper', ellipse(b.cx, headCY, headR * 0.78, headR * 0.85, 14)),
          mass('furniture3', [
            { x: b.cx - headR * 0.95, y: headCY + headR * 0.15, z: atT() },
            { x: b.cx + headR * 0.85, y: headCY + headR * 0.25, z: atT() },
            { x: b.cx + headR * 0.7, y: headCY - headR * 0.85, z: atT() },
            { x: b.cx - headR * 0.75, y: headCY - headR * 0.95, z: atT() },
          ]),
          stroke(
            'ink',
            [
              { x: b.cx + headR * 0.3, y: headCY + headR * 0.25, z: atT() },
              { x: b.cx + headR * 0.55, y: headCY + headR * 0.42, z: atT() },
            ],
            'kiuchi-nose',
            WEIGHTS.detail,
          ),
          mass('fabric', [
            { x: b.cx - bodyX * 0.85, y: shoulderY + 0.02, z: atT() },
            { x: b.cx + bodyX * 0.85, y: shoulderY + 0.02, z: atT() },
            { x: b.cx + bodyX * 1.05, y: shoulderY + 0.1, z: atT() },
            { x: b.cx + bodyX * 0.92, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 0.92, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 1.05, y: shoulderY + 0.1, z: atT() },
          ]),
          mass('fabric', [
            { x: b.cx - bodyX * 0.5, y: shoulderY - 0.005, z: atT() },
            { x: b.cx - bodyX * 0.15, y: shoulderY - 0.03, z: atT() },
            { x: b.cx + bodyX * 0.3, y: shoulderY - 0.02, z: atT() },
            { x: b.cx + bodyX * 0.5, y: shoulderY + 0.03, z: atT() },
          ]),
          stroke(
            'ink',
            [
              { x: b.cx - bodyX * 0.62, y: shoulderY + 0.16, z: atT() },
              { x: b.cx - bodyX * 0.55, y: shoulderY + 0.3, z: atT() },
            ],
            'kiuchi-pocketL',
            WEIGHTS.detail,
          ),
          stroke(
            'ink',
            [
              { x: b.cx + bodyX * 0.62, y: shoulderY + 0.16, z: atT() },
              { x: b.cx + bodyX * 0.55, y: shoulderY + 0.3, z: atT() },
            ],
            'kiuchi-pocketR',
            WEIGHTS.detail,
          ),
        ];
      },
    },
    // 7. The Tokyo-night silhouette: the back-lit resident against the warm
    // room — dark hair and shoulders over the lamp's pool of light.
    {
      name: 'heimetric',
      w: 0.46,
      h: 1.35,
      draw: (s, hair) => {
        const b = base(s, 1.35);
        const headR = 0.085;
        const headCY = b.crownY + headR * 1.2;
        const neckW = 0.035;
        const shoulderY = headCY + headR + 0.045;
        const bodyX = 0.175;
        return [
          mass('ambient', circ(b.cx, headCY + 0.02, headR * 2.4, 18)),
          mass('ambient', [
            { x: b.cx - bodyX * 1.9, y: shoulderY - 0.01, z: atT() },
            { x: b.cx + bodyX * 1.9, y: shoulderY - 0.01, z: atT() },
            { x: b.cx + bodyX * 1.6, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 1.6, y: b.sightY + 0.1, z: atT() },
          ]),
          mass('ink', circ(b.cx, headCY, headR)),
          mass('ink', [
            { x: b.cx - neckW, y: headCY + headR * 0.5, z: atT() },
            { x: b.cx + neckW, y: headCY + headR * 0.5, z: atT() },
            { x: b.cx + neckW * 1.5, y: shoulderY + 0.02, z: atT() },
            { x: b.cx - neckW * 1.5, y: shoulderY + 0.02, z: atT() },
          ]),
          mass('ink', [
            { x: b.cx - bodyX, y: shoulderY + 0.05, z: atT() },
            { x: b.cx + bodyX, y: shoulderY + 0.05, z: atT() },
            { x: b.cx + bodyX * 0.92, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 0.92, y: b.sightY + 0.1, z: atT() },
          ]),
          ...hairBlob('ink', b.cx, headCY, headR, hair),
        ];
      },
    },
    // 8. The Matisse cut-out: the body as one organic paper shape — a
    // distinct head bump fused into an angular swayed body.
    {
      name: 'matisse',
      w: 0.42,
      h: 1.32,
      draw: (s) => {
        const b = base(s, 1.32);
        const headR = 0.075;
        const headCY = b.crownY + headR * 1.1;
        const sway = 0.025;
        const shoulderY = headCY + headR * 1.15;
        return [
          mass('ink', ellipse(b.cx + 0.012, headCY, headR * 0.92, headR)),
          mass('ink', [
            { x: b.cx - 0.115, y: shoulderY + 0.02, z: atT() },
            { x: b.cx + 0.14, y: shoulderY - 0.01, z: atT() },
            { x: b.cx + 0.185, y: shoulderY + 0.18, z: atT() },
            { x: b.cx + 0.16 + sway, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - 0.13 + sway, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - 0.185, y: shoulderY + 0.22, z: atT() },
          ]),
        ];
      },
    },
    // 9. The pictogram: the AIGA-sign person — a detached round head over
    // the rounded-shoulder tapered body, read at a glance from a car.
    {
      name: 'pictogram',
      w: 0.38,
      h: 1.25,
      draw: (s) => {
        const b = base(s, 1.25);
        const headR = 0.085;
        const headCY = b.crownY + headR;
        const bodyTop = headCY + headR * 1.7;
        const bodyX = 0.145;
        return [
          mass('ink', circ(b.cx, headCY, headR)),
          mass('ink', [
            { x: b.cx - bodyX * 0.55, y: bodyTop, z: atT() },
            { x: b.cx + bodyX * 0.55, y: bodyTop, z: atT() },
            { x: b.cx + bodyX, y: bodyTop + 0.045, z: atT() },
            { x: b.cx + bodyX * 0.78, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX * 0.78, y: b.sightY + 0.1, z: atT() },
            { x: b.cx - bodyX, y: bodyTop + 0.045, z: atT() },
          ]),
        ];
      },
    },
    // 10. The Sempé figure: a small, sparse ink line person — a circle head,
    // a hat brim, a long nose, one coat line — lost in the big quiet pane.
    {
      name: 'sempe',
      w: 0.36,
      h: 1.15,
      draw: (s) => {
        const b = base(s, 1.15);
        const headR = 0.055;
        const headCY = b.crownY + headR * 1.35;
        const shoulderY = headCY + headR + 0.05;
        const bodyX = 0.1;
        return [
          stroke('ink', ellipse(b.cx, headCY, headR * 0.8, headR * 0.95, 14), 'sempe-head', WEIGHTS.outline),
          stroke(
            'ink',
            [
              { x: b.cx - headR * 1.7, y: headCY - headR * 0.55, z: atT() },
              { x: b.cx, y: headCY - headR * 1.15, z: atT() },
              { x: b.cx + headR * 1.9, y: headCY - headR * 0.45, z: atT() },
            ],
            'sempe-brim',
            WEIGHTS.outline,
          ),
          stroke(
            'ink',
            [
              { x: b.cx + headR * 0.55, y: headCY + headR * 0.1, z: atT() },
              { x: b.cx + headR * 1.0, y: headCY + headR * 0.25, z: atT() },
            ],
            'sempe-nose',
            WEIGHTS.detail,
          ),
          stroke(
            'ink',
            [
              { x: b.cx - bodyX, y: b.sightY + 0.1, z: atT() },
              { x: b.cx - bodyX * 0.9, y: shoulderY + 0.02, z: atT() },
              { x: b.cx, y: shoulderY, z: atT() },
              { x: b.cx + bodyX * 0.9, y: shoulderY + 0.02, z: atT() },
              { x: b.cx + bodyX, y: b.sightY + 0.1, z: atT() },
            ],
            'sempe-body',
            WEIGHTS.outline,
          ),
        ];
      },
    },
  ];

  const KINDS_SHEET_COLS = 3;
  const STRIP_COLS = 5;

  function fit(box: { width: number; height: number; dpr: number }, cols: number, rows: number) {
    const scale = Math.min(box.width / (cols * UNIT_PITCH_X), box.height / (rows * UNIT_PITCH_Y));
    return { scale: box.dpr * scale, cx: (box.width * box.dpr) / 2, cy: (box.height * box.dpr) / 2 };
  }

  function plateOrigin(g: ReturnType<typeof fit>, i: number, cols: number, rows: number) {
    const ox = ((i % cols) - (cols - 1) / 2) * UNIT_PITCH_X;
    const oy = (Math.floor(i / cols) - (rows - 1) / 2) * UNIT_PITCH_Y;
    return { ox, oy };
  }

  function pointerEye(): (canvas: HTMLCanvasElement) => { x: number; y: number } {
    const pointer = { x: 0, y: 0 };
    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX / window.innerWidth - 0.5;
      pointer.y = e.clientY / window.innerHeight - 0.5;
    });
    return () => ({ ...pointer });
  }

  const labelFont = `${getComputedStyle(document.body).getPropertyValue('--typography-body2-fontFamily').trim() || 'sans-serif'}`;

  // One window scene per style: shell, a pinned coat stand opposite the
  // lamp — the size anchor — the tenant centred on its plane, sill. No
  // curtain: a rolled curtain would cover the figure it sits behind.
  function humanPlate(c: Candidate, seed: number, i: number, theme: Theme, time: number, ctx: CanvasRenderingContext2D): void {
    const pen = new Pen({ ...DEFAULT_TUNING }, windowSeed(seed, i, 0));
    pen.setTime(time);
    const plan = expandShell(pen.seed);
    const opening: PaneRect = innerRect(plan.faceWidth);
    const rng = fork(pen.seed, 'dna');
    const sill = sillMarks(rng, opening);
    const lamp = pinnedLamp({ location: i % 2 === 0 ? 'innerRight' : 'innerLeft' });
    const hair = rollHair(seed, i);
    const room = roomOf(opening);
    const cx = (opening.left + opening.right) / 2;
    const x0 = cx - c.w / 2;
    const spot: Spot = { x0, x1: x0 + c.w, floorY: room.bottom, topY: room.bottom - c.h, w: c.w, h: c.h };
    execute(
      [
        ...shellMarks(plan),
        ...drawFurniture({ pieces: [{ kind: 'coatStand', plane: 4, side: lamp.location === 'innerRight' ? 'left' : 'right' }] }, opening),
        ...lampMarks(lamp, opening, theme.isNight),
        ...c.draw(spot, hair),
        ...sill,
      ],
      pen,
      ctx,
      windowPalette(pen.seed, theme),
      makeProjection({ x: 0, y: 0 }),
      opening,
    );
  }

  function mountKinds(canvas: HTMLCanvasElement, label: HTMLSpanElement, button: HTMLButtonElement): void {
    let seed = rollSeed();
    const show = () => (label.textContent = `seed ${seed}`);
    show();
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme) => {
        const box = cssBox(canvas);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        // ?kind=<name> collapses the sheet to one huge plate — the close
        // look without a screenshot slicer.
        const one = new URLSearchParams(window.location.search).get('kind');
        const shown = CANDIDATES.filter((c) => !one || c.name === one);
        const cols = one ? shown.length : KINDS_SHEET_COLS;
        const rws = Math.ceil(shown.length / cols);
        const g = fit(box, cols, rws);
        ctx.setTransform(g.scale, 0, 0, g.scale, g.cx, g.cy);
        shown.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, cols, rws);
          ctx.save();
          ctx.translate(ox, oy);
          humanPlate(c, seed, i, theme, time, ctx);
          ctx.restore();
        });
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.ink;
        ctx.globalAlpha = 0.75;
        ctx.font = `${Math.max(10, 0.16 * g.scale)}px ${labelFont}`;
        ctx.textAlign = 'center';
        shown.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, cols, rws);
          ctx.fillText(c.name, g.cx + ox * g.scale, g.cy + oy * g.scale + 0.82 * g.scale);
        });
        ctx.globalAlpha = 1;
      },
      pointerEye(),
    );
    button.addEventListener('click', () => {
      seed = rollSeed();
      show();
    });
  }

  function mountStrip(canvas: HTMLCanvasElement): void {
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme) => {
        const box = cssBox(canvas);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        const rows = Math.ceil(CANDIDATES.length / STRIP_COLS);
        const g = fit(box, STRIP_COLS, rows);
        ctx.setTransform(g.scale, 0, 0, g.scale, g.cx, g.cy);
        CANDIDATES.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, STRIP_COLS, rows);
          ctx.save();
          ctx.translate(ox, oy);
          humanPlate(c, 424242, i, theme, time, ctx);
          ctx.restore();
        });
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.ink;
        ctx.globalAlpha = 0.75;
        ctx.font = `${Math.max(9, 0.14 * g.scale)}px ${labelFont}`;
        ctx.textAlign = 'center';
        CANDIDATES.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, STRIP_COLS, rows);
          ctx.fillText(c.name, g.cx + ox * g.scale, g.cy + oy * g.scale + 1.02 * g.scale);
        });
        ctx.globalAlpha = 1;
      },
      pointerEye(),
    );
  }

  const el = (id: string) => document.getElementById(id)!;
  mountKinds(el('kinds') as HTMLCanvasElement, el('kinds-seed'), el('kinds-reseed') as HTMLButtonElement);
  mountStrip(el('strip') as HTMLCanvasElement);
</script>
