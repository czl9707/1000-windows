---
import BaseLayout from '@/components/layouts/BaseLayout.astro';
---

<BaseLayout title="Human bench">
  <main>
    <h1>Human bench</h1>
    <p>
      Prototype, throwaway, round three: ten illustration languages for the
      tenant — each a different shape system and palette, the same pose.
      Round two fixed the proportions but kept one silhouette; the eyeball
      wants whole styles: the Notion avatar, the SANAA render figure, the
      Sempé line, the Jullien blob, and so on. The tenant stands 1.25 on the
      room floor at a furniture plane — below the coat stand's 1.4, the way
      someone behind the room reads from the street. Every plate pins the
      coat stand as the size anchor. The sheet gives every style one large
      plate; the strip shows the same windows at street density. Daylight
      pinned; the button re-rolls in place.
    </p>

    <section>
      <h2>The styles</h2>
      <canvas id="kinds" width="900" height="1500"></canvas>
      <button id="kinds-reseed" type="button">New sheet</button>
      <span id="kinds-seed"></span>
    </section>

    <section>
      <h2>The street strip</h2>
      <canvas id="strip" width="900" height="290"></canvas>
      <p>Same windows, five to a row at half pitch — the far-wall density.</p>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }
  canvas {
    width: 100%;
    height: auto;
    display: block;
    border: var(--border);
  }
  section {
    margin-bottom: 2rem;
  }
</style>

<script>
  // PROTOTYPE, throwaway: candidate illustration languages for the tenant,
  // drawn as marks into a real window scene. The language the eye picks
  // graduates into the occupant layer; this page does not survive the
  // milestone.
  import { createDemoLoop, cssBox } from '@/components/demoLoop';
  import { Pen } from '@/pen/pen';
  import { DEFAULT_TUNING } from '@/pen/tuning';
  import { rollSeed } from '@/components/mount';
  import type { Theme, ColorRole } from '@/styling/roles';
  import { WEIGHTS } from '@/styling/weights';
  import { windowPalette } from '@/styling/colourway';
  import { fork, windowSeed } from '@/core/randomness/rng';
  import { execute, type Mark } from '@/core/scene';
  import { shellMarks, expandShell } from '@/core/window-shell';
  import { innerRect, type PaneRect } from '@/core/window-shell/shell';
  import { sillMarks } from '@/core/sill';
  import { pinnedLamp } from '@/core/light/light';
  import { lampMarks } from '@/core/light/drawLamp';
  import type { Pt3 } from '@/motion/projection';
  import { roomOf } from '@/core/furniture/room';
  import { drawFurniture } from '@/core/furniture/drawFurniture';
  import { makeProjection } from '@/motion/projection';

  const UNIT_PITCH_X = 2.3;
  const UNIT_PITCH_Y = 1.8;

  // Daylight pinned: the interior judges best with the lamps dark.
  document.body.setAttribute('data-theme', 'light');

  // The tenant stands behind the furniture plane — the street reads someone
  // standing well back in the room, smaller than the coat stand in front.
  const TENANT_DEPTH = -0.15;
  const TENANT_Z = -8.8;
  const atT = () => TENANT_DEPTH;
  const zT = () => TENANT_Z;

  interface Spot {
    x0: number;
    x1: number;
    floorY: number;
    topY: number;
    w: number;
    h: number;
  }

  interface Candidate {
    name: string;
    w: number;
    h: number;
    draw: (s: Spot, seed: number, i: number) => Mark[];
  }

  const mass = (role: ColorRole, pts: Pt3[]): Mark => ({ kind: 'fill', pts, role, z: zT() });
  const stroke = (role: ColorRole, pts: Pt3[], name: string, widthUnits: number): Mark => ({
    kind: 'stroke',
    pts,
    name,
    widthUnits,
    role,
    z: zT(),
  });
  const dot = (role: ColorRole, p: { x: number; y: number }, r: number, name: string): Mark => ({
    kind: 'dot',
    pts: [{ x: p.x, y: p.y, z: atT() }],
    role,
    z: zT(),
    name,
    r,
  });
  const cxOf = (s: Spot) => (s.x0 + s.x1) / 2;

  function ellipse(cx: number, cy: number, rx: number, ry: number, n = 16): Pt3[] {
    return Array.from({ length: n }, (_, i) => {
      const a = (i / n) * Math.PI * 2;
      return { x: cx + Math.cos(a) * rx, y: cy + Math.sin(a) * ry, z: atT() };
    });
  }

  const circ = (cx: number, cy: number, r: number, n = 14) => ellipse(cx, cy, r, r, n);

  // The shared build: crown, head, chin, shoulder line, sightline. Height
  // 1.25 on the room floor shows a little over a third of the pane — the
  // head, the neck, the top of the shoulders, the way someone standing well
  // back reads from the street.
  interface Build {
    cx: number;
    h: number;
    crownY: number;
    headRx: number;
    headRy: number;
    headCY: number;
    chinY: number;
    neckW: number;
    shoulderY: number;
    shoulderX: number;
    sightY: number;
  }

  function build(s: Spot, height: number, headShare = 6.5): Build {
    const cx = cxOf(s) + 0.012 * s.h * Math.sin(s.x0 * 9.1);
    const crownY = s.floorY - height;
    const headRx = height / headShare / 2.15;
    const headRy = height / headShare / 1.85;
    const headCY = crownY + headRy;
    const chinY = headCY + headRy * 0.95;
    const shoulderY = chinY + height * 0.05;
    return {
      cx,
      h: height,
      crownY,
      headRx,
      headRy,
      headCY,
      chinY,
      neckW: height * 0.03,
      shoulderY,
      shoulderX: height * 0.115,
      sightY: s.floorY - 0.85,
    };
  }

  const CANDIDATES: Candidate[] = [
    // 1. The Notion avatar: one flat pastel mass — round head flowing into
    // rounded shoulders — no face, no outline.
    {
      name: 'notionAvatar',
      w: 0.3,
      h: 1.25,
      draw: (s) => {
        const b = build(s, 1.25, 5.5);
        return [
          mass('fabric', circ(b.cx, b.headCY, b.headRx * 1.05)),
          mass('fabric', [
            { x: b.cx - b.shoulderX * 0.8, y: b.shoulderY, z: atT() },
            { x: b.cx + b.shoulderX * 0.8, y: b.shoulderY, z: atT() },
            { x: b.cx + b.shoulderX, y: b.shoulderY + 0.06, z: atT() },
            { x: b.cx + b.shoulderX, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX, y: b.shoulderY + 0.06, z: atT() },
          ]),
          dot('ink', { x: b.cx - b.headRx * 0.38, y: b.headCY - b.headRy * 0.05 }, b.headRx * 0.11, 'notionAvatar-eyeL'),
          dot('ink', { x: b.cx + b.headRx * 0.38, y: b.headCY - b.headRy * 0.05 }, b.headRx * 0.11, 'notionAvatar-eyeR'),
        ];
      },
    },
    // 2. The SANAA render figure: pale, featureless, one smooth continuous
    // silhouette — a soft white symbol of a person, barely there.
    {
      name: 'sejimaFigure',
      w: 0.28,
      h: 1.3,
      draw: (s) => {
        const b = build(s, 1.3, 8);
        return [
          mass('furniture5', ellipse(b.cx, b.headCY, b.headRx, b.headRy * 1.04)),
          mass('furniture5', [
            { x: b.cx - b.neckW, y: b.chinY - b.headRy * 0.3, z: atT() },
            { x: b.cx + b.neckW, y: b.chinY - b.headRy * 0.3, z: atT() },
            { x: b.cx + b.shoulderX * 0.9, y: b.shoulderY + 0.05, z: atT() },
            { x: b.cx + b.shoulderX * 0.82, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX * 0.82, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX * 0.9, y: b.shoulderY + 0.05, z: atT() },
          ]),
        ];
      },
    },
    // 3. The Sempé line figure: one loose ink contour, a couple of gesture
    // strokes inside — the drawn stranger in the crowd.
    {
      name: 'sempeLine',
      w: 0.3,
      h: 1.3,
      draw: (s) => {
        const b = build(s, 1.3, 7);
        const crown: Pt3[] = Array.from({ length: 9 }, (_, i) => {
          const a = Math.PI * (1 - i / 8);
          return { x: b.cx + Math.cos(a) * b.headRx * 1.04, y: b.headCY + b.headRy * 0.1 - Math.sin(a) * b.headRy * 1.06, z: atT() };
        });
        const left: Pt3[] = [
          { x: b.cx - b.shoulderX * 0.9, y: b.sightY + 0.12, z: atT() },
          { x: b.cx - b.shoulderX * 0.95, y: b.shoulderY + 0.04, z: atT() },
          { x: b.cx - b.neckW * 0.8, y: b.shoulderY - 0.02, z: atT() },
          { x: b.cx - b.headRx * 0.9, y: b.chinY, z: atT() },
          ...crown,
        ];
        const right: Pt3[] = [
          { x: b.cx + b.headRx * 0.9, y: b.chinY, z: atT() },
          { x: b.cx + b.neckW * 0.8, y: b.shoulderY - 0.02, z: atT() },
          { x: b.cx + b.shoulderX * 0.95, y: b.shoulderY + 0.04, z: atT() },
          { x: b.cx + b.shoulderX * 0.9, y: b.sightY + 0.12, z: atT() },
        ];
        return [
          stroke('ink', [...left, ...right], 'sempeLine-contour', WEIGHTS.outline),
          stroke(
            'ink',
            [
              { x: b.cx - b.shoulderX * 0.55, y: b.shoulderY + 0.05, z: atT() },
              { x: b.cx - b.shoulderX * 0.3, y: b.sightY + 0.1, z: atT() },
            ],
            'sempeLine-lapel',
            WEIGHTS.detail,
          ),
          stroke(
            'ink',
            [
              { x: b.cx + b.headRx * 0.15, y: b.headCY + b.headRy * 0.3, z: atT() },
              { x: b.cx + b.headRx * 0.5, y: b.headCY + b.headRy * 0.1, z: atT() },
            ],
            'sempeLine-brow',
            WEIGHTS.detail,
          ),
        ];
      },
    },
    // 4. The Jullien blob: thick black, no neck, the head melting into
    // rounded shoulders, two dot eyes and a smile.
    {
      name: 'jullienBlob',
      w: 0.34,
      h: 1.3,
      draw: (s) => {
        const b = build(s, 1.3, 4.5);
        return [
          mass('ink', ellipse(b.cx, b.headCY + b.headRy * 0.35, b.headRx * 1.28, b.headRy * 1.5, 18)),
          mass('ink', [
            { x: b.cx - b.shoulderX, y: b.shoulderY + 0.02, z: atT() },
            { x: b.cx + b.shoulderX, y: b.shoulderY + 0.02, z: atT() },
            { x: b.cx + b.shoulderX * 0.92, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX * 0.92, y: b.sightY + 0.12, z: atT() },
          ]),
          dot('paper', { x: b.cx - b.headRx * 0.4, y: b.headCY + b.headRy * 0.15 }, b.headRx * 0.13, 'jullien-eyeL'),
          dot('paper', { x: b.cx + b.headRx * 0.4, y: b.headCY + b.headRy * 0.15 }, b.headRx * 0.13, 'jullien-eyeR'),
          stroke(
            'paper',
            [
              { x: b.cx - b.headRx * 0.32, y: b.headCY + b.headRy * 0.62, z: atT() },
              { x: b.cx, y: b.headCY + b.headRy * 0.78, z: atT() },
              { x: b.cx + b.headRx * 0.32, y: b.headCY + b.headRy * 0.62, z: atT() },
            ],
            'jullien-smile',
            WEIGHTS.detail,
          ),
        ];
      },
    },
    // 5. The paper cut: a crisp black profile facing out — forehead, nose,
    // chin, the bun at the back of the skull.
    {
      name: 'papercutProfile',
      w: 0.3,
      h: 1.3,
      draw: (s) => {
        const b = build(s, 1.3, 6.5);
        const face = b.cx + b.headRx * 0.5;
        const marks: Mark[] = [
          mass('ink', ellipse(b.cx, b.headCY, b.headRx, b.headRy * 0.98)),
          mass('ink', [
            { x: face + b.headRx * 0.45, y: b.headCY - b.headRy * 0.5, z: atT() },
            { x: face + b.headRx * 0.72, y: b.headCY + b.headRy * 0.02, z: atT() },
            { x: face + b.headRx * 0.55, y: b.headCY + b.headRy * 0.28, z: atT() },
            { x: face + b.headRx * 0.25, y: b.headCY + b.headRy * 0.5, z: atT() },
          ]),
          mass('ink', circ(b.cx - b.headRx * 0.55, b.crownY + b.headRy * 0.42, b.headRx * 0.42)),
          mass('ink', [
            { x: b.cx - b.neckW * 1.1, y: b.chinY - b.headRy * 0.25, z: atT() },
            { x: b.cx + b.neckW * 1.1, y: b.chinY - b.headRy * 0.25, z: atT() },
            { x: b.cx + b.shoulderX * 0.95, y: b.shoulderY + 0.05, z: atT() },
            { x: b.cx + b.shoulderX * 0.85, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX * 0.85, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX * 0.95, y: b.shoulderY + 0.05, z: atT() },
          ]),
        ];
        return marks;
      },
    },
    // 6. The pictogram: the icon grammar — a detached circle head over a
    // tapered body, solid ink, the gap doing the work.
    {
      name: 'pictogram',
      w: 0.3,
      h: 1.3,
      draw: (s) => {
        const b = build(s, 1.3, 6);
        return [
          mass('ink', circ(b.cx, b.headCY, b.headRx)),
          mass('ink', [
            { x: b.cx - b.shoulderX * 0.62, y: b.shoulderY + 0.03, z: atT() },
            { x: b.cx + b.shoulderX * 0.62, y: b.shoulderY + 0.03, z: atT() },
            { x: b.cx + b.shoulderX * 0.4, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX * 0.4, y: b.sightY + 0.12, z: atT() },
          ]),
        ];
      },
    },
    // 7. The Matisse cutout: one organic coloured mass, lopsided, with
    // paper-coloured leaf cuts floating inside.
    {
      name: 'matisseCut',
      w: 0.36,
      h: 1.35,
      draw: (s, seed, i) => {
        const r = fork(windowSeed(seed, i, 0), 'tenant-matisse');
        const lean = (r.float(0, 1) - 0.5) * b0(s).headRx * 0.9;
        const b = build(s, 1.35, 5);
        return [
          mass('fabric', ellipse(b.cx + lean, b.headCY + b.headRy * 0.15, b.headRx * 1.12, b.headRy * 1.08, 18)),
          mass('fabric', [
            { x: b.cx - b.shoulderX * 1.02, y: b.shoulderY + 0.02, z: atT() },
            { x: b.cx + b.shoulderX * 0.86, y: b.shoulderY + 0.015, z: atT() },
            { x: b.cx + b.shoulderX * 0.96, y: b.shoulderY + 0.08, z: atT() },
            { x: b.cx + b.shoulderX * 0.8, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX * 0.92, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX * 1.06, y: b.shoulderY + 0.07, z: atT() },
          ]),
          mass('paper', ellipse(b.cx + lean + b.headRx * 0.25, b.headCY - b.headRy * 0.1, b.headRx * 0.3, b.headRy * 0.22)),
          mass('paper', ellipse(b.cx - b.shoulderX * 0.35, b.sightY - 0.02, b.headRx * 0.34, b.headRy * 0.2)),
        ];
      },
    },
    // 8. The woodblock print: ink hair in a topknot over a pale face, flat
    // garment block with collar lines — ukiyo-e grammar.
    {
      name: 'woodblock',
      w: 0.32,
      h: 1.3,
      draw: (s) => {
        const b = build(s, 1.3, 6.5);
        return [
          mass('furniture6', ellipse(b.cx, b.headCY, b.headRx, b.headRy)),
          mass('ink', ellipse(b.cx, b.headCY - b.headRy * 0.28, b.headRx * 1.08, b.headRy * 0.82)),
          mass('ink', circ(b.cx, b.crownY + b.headRy * 0.18, b.headRx * 0.34)),
          mass('fabric', [
            { x: b.cx - b.shoulderX * 0.9, y: b.shoulderY, z: atT() },
            { x: b.cx + b.shoulderX * 0.9, y: b.shoulderY, z: atT() },
            { x: b.cx + b.shoulderX, y: b.shoulderY + 0.06, z: atT() },
            { x: b.cx + b.shoulderX * 0.94, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX * 0.94, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX, y: b.shoulderY + 0.06, z: atT() },
          ]),
          stroke(
            'ink',
            [
              { x: b.cx - b.neckW * 0.6, y: b.shoulderY - 0.01, z: atT() },
              { x: b.cx - b.shoulderX * 0.18, y: b.shoulderY + 0.09, z: atT() },
            ],
            'woodblock-collarL',
            WEIGHTS.detail,
          ),
          stroke(
            'ink',
            [
              { x: b.cx + b.neckW * 0.6, y: b.shoulderY - 0.01, z: atT() },
              { x: b.cx + b.shoulderX * 0.18, y: b.shoulderY + 0.09, z: atT() },
            ],
            'woodblock-collarR',
            WEIGHTS.detail,
          ),
        ];
      },
    },
    // 9. The one-line drawing: a single continuous stroke that wanders up
    // the shoulder, around the crown, and back down — never lifting.
    {
      name: 'oneline',
      w: 0.32,
      h: 1.3,
      draw: (s) => {
        const b = build(s, 1.3, 6.5);
        const crown: Pt3[] = Array.from({ length: 11 }, (_, i) => {
          const a = Math.PI * (1 - i / 10);
          return { x: b.cx + Math.cos(a) * b.headRx * 1.05, y: b.headCY + b.headRy * 0.12 - Math.sin(a) * b.headRy * 1.08, z: atT() };
        });
        const line: Pt3[] = [
          { x: b.cx - b.shoulderX * 0.95, y: b.sightY + 0.12, z: atT() },
          { x: b.cx - b.shoulderX * 0.9, y: b.shoulderY + 0.05, z: atT() },
          { x: b.cx - b.neckW * 0.7, y: b.chinY + 0.01, z: atT() },
          { x: b.cx - b.headRx * 0.85, y: b.headCY + b.headRy * 0.35, z: atT() },
          ...crown,
          { x: b.cx + b.headRx * 0.8, y: b.headCY + b.headRy * 0.55, z: atT() },
          { x: b.cx + b.headRx * 0.35, y: b.chinY, z: atT() },
          { x: b.cx + b.neckW * 0.7, y: b.shoulderY - 0.03, z: atT() },
          { x: b.cx + b.shoulderX * 0.92, y: b.shoulderY + 0.06, z: atT() },
          { x: b.cx + b.shoulderX * 0.6, y: b.sightY - 0.05, z: atT() },
        ];
        return [stroke('ink', line, 'oneline-stroke', WEIGHTS.outline)];
      },
    },
    // 10. The deco block: angular bob helmet in ink, pale face, long neck,
    // an angular garment block in a second colour — poster geometry.
    {
      name: 'decoBlock',
      w: 0.32,
      h: 1.3,
      draw: (s) => {
        const b = build(s, 1.3, 7);
        return [
          mass('furniture6', ellipse(b.cx, b.headCY + b.headRy * 0.1, b.headRx * 0.94, b.headRy * 0.92)),
          mass('ink', [
            { x: b.cx - b.headRx * 1.16, y: b.headCY + b.headRy * 0.28, z: atT() },
            { x: b.cx - b.headRx * 1.02, y: b.headCY - b.headRy * 0.72, z: atT() },
            { x: b.cx, y: b.headCY - b.headRy * 0.92, z: atT() },
            { x: b.cx + b.headRx * 1.02, y: b.headCY - b.headRy * 0.72, z: atT() },
            { x: b.cx + b.headRx * 1.16, y: b.headCY + b.headRy * 0.28, z: atT() },
            { x: b.cx + b.headRx * 0.6, y: b.headCY + b.headRy * 0.42, z: atT() },
            { x: b.cx - b.headRx * 0.6, y: b.headCY + b.headRy * 0.42, z: atT() },
          ]),
          mass('fabric', [
            { x: b.cx - b.shoulderX * 0.95, y: b.shoulderY + 0.05, z: atT() },
            { x: b.cx + b.shoulderX * 0.95, y: b.shoulderY + 0.05, z: atT() },
            { x: b.cx + b.shoulderX * 0.88, y: b.sightY + 0.12, z: atT() },
            { x: b.cx - b.shoulderX * 0.88, y: b.sightY + 0.12, z: atT() },
          ]),
          stroke(
            'ink',
            [
              { x: b.cx, y: b.chinY + b.headRy * 0.1, z: atT() },
              { x: b.cx, y: b.shoulderY, z: atT() },
            ],
            'decoBlock-neckline',
            WEIGHTS.detail,
          ),
        ];
      },
    },
  ];

  // The Matisse cut's helper reads the spot before its own build — one
  // tiny local alias keeps the draw body readable.
  const b0 = (s: Spot) => build(s, 1.35, 5);

  const KINDS_SHEET_COLS = 3;
  const STRIP_COLS = 5;

  function fit(box: { width: number; height: number; dpr: number }, cols: number, rows: number) {
    const scale = Math.min(box.width / (cols * UNIT_PITCH_X), box.height / (rows * UNIT_PITCH_Y));
    return { scale: box.dpr * scale, cx: (box.width * box.dpr) / 2, cy: (box.height * box.dpr) / 2 };
  }

  function plateOrigin(g: ReturnType<typeof fit>, i: number, cols: number, rows: number) {
    const ox = ((i % cols) - (cols - 1) / 2) * UNIT_PITCH_X;
    const oy = (Math.floor(i / cols) - (rows - 1) / 2) * UNIT_PITCH_Y;
    return { ox, oy };
  }

  function pointerEye(): (canvas: HTMLCanvasElement) => { x: number; y: number } {
    const pointer = { x: 0, y: 0 };
    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX / window.innerWidth - 0.5;
      pointer.y = e.clientY / window.innerHeight - 0.5;
    });
    return () => ({ ...pointer });
  }

  const labelFont = `${getComputedStyle(document.body).getPropertyValue('--typography-body2-fontFamily').trim() || 'sans-serif'}`;

  // One window scene per language: shell, a pinned coat stand opposite the
  // lamp — the size anchor — the tenant centred on its plane, sill. No
  // curtain: a rolled curtain would cover the figure it sits behind.
  function humanPlate(c: Candidate, seed: number, i: number, theme: Theme, time: number, ctx: CanvasRenderingContext2D): void {
    const pen = new Pen({ ...DEFAULT_TUNING }, windowSeed(seed, i, 0));
    pen.setTime(time);
    const plan = expandShell(pen.seed);
    const opening: PaneRect = innerRect(plan.faceWidth);
    const rng = fork(pen.seed, 'dna');
    const sill = sillMarks(rng, opening);
    const lamp = pinnedLamp({ location: i % 2 === 0 ? 'innerRight' : 'innerLeft' });
    const room = roomOf(opening);
    const cx = (opening.left + opening.right) / 2;
    const x0 = cx - c.w / 2;
    const spot: Spot = { x0, x1: x0 + c.w, floorY: room.bottom, topY: room.bottom - c.h, w: c.w, h: c.h };
    execute(
      [
        ...shellMarks(plan),
        ...drawFurniture({ pieces: [{ kind: 'coatStand', plane: 4, side: lamp.location === 'innerRight' ? 'left' : 'right' }] }, opening),
        ...lampMarks(lamp, opening, theme.isNight),
        ...c.draw(spot, seed, i),
        ...sill,
      ],
      pen,
      ctx,
      windowPalette(pen.seed, theme),
      makeProjection({ x: 0, y: 0 }),
      opening,
    );
  }

  function mountKinds(canvas: HTMLCanvasElement, label: HTMLSpanElement, button: HTMLButtonElement): void {
    let seed = rollSeed();
    const show = () => (label.textContent = `seed ${seed}`);
    show();
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme) => {
        const box = cssBox(canvas);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        // ?kind=<name> collapses the sheet to one huge plate — the close
        // look without a screenshot slicer.
        const one = new URLSearchParams(window.location.search).get('kind');
        const shown = CANDIDATES.filter((c) => !one || c.name === one);
        const cols = one ? shown.length : KINDS_SHEET_COLS;
        const rws = Math.ceil(shown.length / cols);
        const g = fit(box, cols, rws);
        ctx.setTransform(g.scale, 0, 0, g.scale, g.cx, g.cy);
        shown.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, cols, rws);
          ctx.save();
          ctx.translate(ox, oy);
          humanPlate(c, seed, i, theme, time, ctx);
          ctx.restore();
        });
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.ink;
        ctx.globalAlpha = 0.75;
        ctx.font = `${Math.max(10, 0.16 * g.scale)}px ${labelFont}`;
        ctx.textAlign = 'center';
        shown.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, cols, rws);
          ctx.fillText(c.name, g.cx + ox * g.scale, g.cy + oy * g.scale + 0.82 * g.scale);
        });
        ctx.globalAlpha = 1;
      },
      pointerEye(),
    );
    button.addEventListener('click', () => {
      seed = rollSeed();
      show();
    });
  }

  function mountStrip(canvas: HTMLCanvasElement): void {
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme) => {
        const box = cssBox(canvas);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        const rows = Math.ceil(CANDIDATES.length / STRIP_COLS);
        const g = fit(box, STRIP_COLS, rows);
        ctx.setTransform(g.scale, 0, 0, g.scale, g.cx, g.cy);
        CANDIDATES.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, STRIP_COLS, rows);
          ctx.save();
          ctx.translate(ox, oy);
          humanPlate(c, 424242, i, theme, time, ctx);
          ctx.restore();
        });
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.ink;
        ctx.globalAlpha = 0.75;
        ctx.font = `${Math.max(9, 0.14 * g.scale)}px ${labelFont}`;
        ctx.textAlign = 'center';
        CANDIDATES.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, STRIP_COLS, rows);
          ctx.fillText(c.name, g.cx + ox * g.scale, g.cy + oy * g.scale + 1.02 * g.scale);
        });
        ctx.globalAlpha = 1;
      },
      pointerEye(),
    );
  }

  const el = (id: string) => document.getElementById(id)!;
  mountKinds(el('kinds') as HTMLCanvasElement, el('kinds-seed'), el('kinds-reseed') as HTMLButtonElement);
  mountStrip(el('strip') as HTMLCanvasElement);
</script>
