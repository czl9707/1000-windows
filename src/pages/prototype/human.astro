---
import BaseLayout from '@/components/layouts/BaseLayout.astro';
---

<BaseLayout title="Human bench">
  <main>
    <h1>Human bench</h1>
    <p>
      Prototype, throwaway: ten styles of drawing the tenant, one pose —
      standing, facing out — so only the style varies. All follow the
      established language: flat masses on a depth plane (ink or the
      furniture gray), the plants' ribbon-and-circle vocabulary where it
      fits, line weights from the nib catalogue. The sheet gives every style
      one large plate; the strip shows the same windows at street density,
      the pass/fail view. A standing figure of height 1.62 shows 0.77 above
      the sightline — head and shoulders in a pane 0.86 tall. Daylight
      pinned; the button re-rolls in place.
    </p>

    <section>
      <h2>The styles</h2>
      <canvas id="kinds" width="900" height="1500"></canvas>
      <button id="kinds-reseed" type="button">New sheet</button>
      <span id="kinds-seed"></span>
    </section>

    <section>
      <h2>The street strip</h2>
      <canvas id="strip" width="900" height="290"></canvas>
      <p>Same windows, five to a row at half pitch — the far-wall density.</p>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }
  canvas {
    width: 100%;
    height: auto;
    display: block;
    border: var(--border);
  }
  section {
    margin-bottom: 2rem;
  }
</style>

<script>
  // PROTOTYPE, throwaway: candidate styles for the tenant silhouette,
  // drawn as marks into a real window scene. The style the eye picks
  // graduates into the occupant layer; this page does not survive the
  // milestone.
  import { createDemoLoop, cssBox } from '@/components/demoLoop';
  import { Pen } from '@/pen/pen';
  import { DEFAULT_TUNING } from '@/pen/tuning';
  import { rollSeed } from '@/components/mount';
  import type { Theme, ColorRole } from '@/styling/roles';
  import { WEIGHTS } from '@/styling/weights';
  import { windowPalette } from '@/styling/colourway';
  import { fork, windowSeed } from '@/core/randomness/rng';
  import { execute, type Mark } from '@/core/scene';
  import { shellMarks, expandShell } from '@/core/window-shell';
  import { innerRect, type PaneRect } from '@/core/window-shell/shell';
  import { sillMarks } from '@/core/sill';
  import { pinnedLamp } from '@/core/light/light';
  import { lampMarks } from '@/core/light/drawLamp';
  import type { Pt3 } from '@/motion/projection';
  import { roomOf } from '@/core/furniture/room';
  import { makeProjection } from '@/motion/projection';

  const UNIT_PITCH_X = 2.3;
  const UNIT_PITCH_Y = 1.8;

  // Daylight pinned: the interior judges best with the lamps dark.
  document.body.setAttribute('data-theme', 'light');

  // The human stands nearer than the furniture planes and sorts in front
  // of the light block — the occupant is the room's closest body.
  const HUMAN_DEPTH = -0.1;
  const HUMAN_Z = -6.5;
  const atH = () => HUMAN_DEPTH;
  const zH = () => HUMAN_Z;

  interface Spot {
    x0: number;
    x1: number;
    floorY: number;
    topY: number;
    w: number;
    h: number;
  }

  interface Candidate {
    name: string;
    w: number;
    h: number;
    draw: (s: Spot) => Mark[];
  }

  const mass = (role: ColorRole, pts: Pt3[]): Mark => ({ kind: 'fill', pts, role, z: zH() });
  const stroke = (role: ColorRole, pts: Pt3[], name: string, widthUnits: number): Mark => ({
    kind: 'stroke',
    pts,
    name,
    widthUnits,
    role,
    z: zH(),
  });
  const cxOf = (s: Spot) => (s.x0 + s.x1) / 2;

  function circ(cx: number, cy: number, r: number, n = 14): Pt3[] {
    const pts: Pt3[] = [];
    for (let i = 0; i < n; i++) {
      const a = (i / n) * Math.PI * 2;
      pts.push({ x: cx + Math.cos(a) * r, y: cy + Math.sin(a) * r, z: atH() });
    }
    return pts;
  }

  function ribbon(
    q0: { x: number; y: number },
    q1: { x: number; y: number },
    q2: { x: number; y: number },
    w0: number,
    w1: number,
    n = 8,
  ): Pt3[] {
    const p = (t: number) => ({
      x: (1 - t) * (1 - t) * q0.x + 2 * (1 - t) * t * q1.x + t * t * q2.x,
      y: (1 - t) * (1 - t) * q0.y + 2 * (1 - t) * t * q1.y + t * t * q2.y,
    });
    const d = (t: number) => ({
      x: 2 * (1 - t) * (q1.x - q0.x) + 2 * t * (q2.x - q1.x),
      y: 2 * (1 - t) * (q1.y - q0.y) + 2 * t * (q2.y - q1.y),
    });
    const left: Pt3[] = [];
    const right: Pt3[] = [];
    for (let i = 0; i <= n; i++) {
      const t = i / n;
      const pt = p(t);
      const dv = d(t);
      const len = Math.hypot(dv.x, dv.y) || 1;
      const nx = -dv.y / len;
      const ny = dv.x / len;
      const w = (w0 + (w1 - w0) * t) / 2;
      left.push({ x: pt.x + nx * w, y: pt.y + ny * w, z: atH() });
      right.push({ x: pt.x - nx * w, y: pt.y - ny * w, z: atH() });
    }
    return [...left, ...right.reverse()];
  }

  // The shared figure measures, off the man's own height: head radius,
  // shoulder line and width, hip width. Real proportions, nudged toward
  // what reads at wall distance.
  interface Measures {
    cx: number;
    h: number;
    headY: number;
    hr: number;
    shoulderY: number;
    shW: number;
    hipW: number;
    hipY: number;
    sightY: number;
  }

  function measures(s: Spot): Measures {
    const cx = cxOf(s) + 0.012 * s.h * Math.sin(s.x0 * 9.1);
    const hr = 0.095 * s.h;
    return {
      cx,
      h: s.h,
      headY: s.floorY - s.h + hr,
      hr,
      shoulderY: s.floorY - 0.8 * s.h,
      shW: 0.3 * s.h,
      hipW: 0.2 * s.h,
      hipY: s.floorY - 0.44 * s.h,
      sightY: s.floorY - 0.85,
    };
  }

  // Head-and-shoulders mass down to the floor: the clip cuts the body at
  // the sightline, exactly where a figure at the glass disappears.
  function bust(role: ColorRole, m: Measures): Mark[] {
    return [
      mass(role, circ(m.cx, m.headY, m.hr)),
      mass(role, [
        { x: m.cx - m.shW / 2, y: m.shoulderY, z: atH() },
        { x: m.cx + m.shW / 2, y: m.shoulderY, z: atH() },
        { x: m.cx + m.hipW / 2, y: m.sightY + 0.1, z: atH() },
        { x: m.cx - m.hipW / 2, y: m.sightY + 0.1, z: atH() },
      ]),
    ];
  }

  // The whole standing figure: torso, arms hanging at the sides, legs —
  // drawn past the sightline, the aperture clips it.
  function figure(role: ColorRole, m: Measures): Mark[] {
    const marks: Mark[] = [
      mass(role, circ(m.cx, m.headY, m.hr)),
      mass(role, [
        { x: m.cx - m.shW / 2, y: m.shoulderY, z: atH() },
        { x: m.cx + m.shW / 2, y: m.shoulderY, z: atH() },
        { x: m.cx + m.hipW / 2, y: m.hipY, z: atH() },
        { x: m.cx - m.hipW / 2, y: m.hipY, z: atH() },
      ]),
    ];
    for (const side of [-1, 1]) {
      marks.push(
        mass(
          role,
          ribbon(
            { x: m.cx + side * 0.06 * m.shW, y: m.hipY },
            { x: m.cx + side * 0.07 * m.shW, y: (m.hipY + m.sightY) / 2 },
            { x: m.cx + side * 0.055 * m.shW, y: m.sightY + 0.1 },
            0.075 * m.h,
            0.055 * m.h,
          ),
        ),
      );
      marks.push(
        mass(
          role,
          ribbon(
            { x: m.cx + side * 0.46 * m.shW, y: m.shoulderY + 0.015 * m.h },
            { x: m.cx + side * 0.5 * m.shW, y: (m.shoulderY + m.hipY) / 2 },
            { x: m.cx + side * 0.42 * m.shW, y: m.hipY + 0.03 * m.h },
            0.05 * m.h,
            0.04 * m.h,
          ),
        ),
      );
    }
    return marks;
  }

  // The bust contour: shoulder tips, neck, the arc over the head — one
  // open polyline each side of the head.
  function bustContour(m: Measures, bottomY: number): { left: Pt3[]; right: Pt3[] } {
    const neckY = m.headY + m.hr * 0.8;
    const neckX = 0.05 * m.h;
    const arc = (from: number, to: number, n = 8): Pt3[] => {
      const pts: Pt3[] = [];
      for (let i = 0; i <= n; i++) {
        const a = from + (i / n) * (to - from);
        pts.push({ x: m.cx + Math.cos(a) * m.hr, y: m.headY - Math.sin(a) * m.hr, z: atH() });
      }
      return pts;
    };
    const headArc = arc(Math.PI * 0.92, Math.PI * 0.08);
    const left: Pt3[] = [
      { x: m.cx - m.shW / 2, y: bottomY, z: atH() },
      { x: m.cx - m.shW / 2, y: m.shoulderY + 0.03 * m.h, z: atH() },
      { x: m.cx - neckX, y: neckY, z: atH() },
    ];
    const right: Pt3[] = [
      { x: m.cx + neckX, y: neckY, z: atH() },
      { x: m.cx + m.shW / 2, y: m.shoulderY + 0.03 * m.h, z: atH() },
      { x: m.cx + m.shW / 2, y: bottomY, z: atH() },
    ];
    return { left: [...left, ...headArc], right };
  }

  const CANDIDATES: Candidate[] = [
    // 1. The classic back-lit silhouette: solid ink head-and-shoulders at
    // the glass.
    {
      name: 'inkBust',
      w: 0.34,
      h: 1.62,
      draw: (s) => bust('ink', measures(s)),
    },
    // 2. The whole figure in solid ink, standing in the room.
    {
      name: 'inkFigure',
      w: 0.3,
      h: 1.62,
      draw: (s) => figure('ink', measures(s)),
    },
    // 3. The bust in the furniture gray — a resident, not a shadow.
    {
      name: 'grayBust',
      w: 0.34,
      h: 1.62,
      draw: (s) => bust('furniture2', measures(s)),
    },
    // 4. The whole figure as a furniture-gray silhouette, standing on the
    // floor like a piece.
    {
      name: 'grayFigure',
      w: 0.3,
      h: 1.62,
      draw: (s) => figure('furniture2', measures(s)),
    },
    // 5. The bust as pure contour — ink line, no fill.
    {
      name: 'lineBust',
      w: 0.34,
      h: 1.62,
      draw: (s) => {
        const m = measures(s);
        const { left, right } = bustContour(m, m.sightY + 0.06);
        return [
          stroke('ink', left, 'lineBust-left', WEIGHTS.outline),
          stroke('ink', right, 'lineBust-right', WEIGHTS.outline),
        ];
      },
    },
    // 6. The full-figure contour with its interior construction lines —
    // collar V and arm seams.
    {
      name: 'lineFigure',
      w: 0.3,
      h: 1.62,
      draw: (s) => {
        const m = measures(s);
        const { left, right } = bustContour(m, m.sightY + 0.06);
        const chestY = m.shoulderY + 0.08 * m.h;
        const marks: Mark[] = [
          stroke('ink', left, 'lineFigure-left', WEIGHTS.outline),
          stroke('ink', right, 'lineFigure-right', WEIGHTS.outline),
          stroke(
            'ink',
            [
              { x: m.cx - 0.05 * m.h, y: chestY, z: atH() },
              { x: m.cx, y: chestY + 0.06 * m.h, z: atH() },
              { x: m.cx + 0.05 * m.h, y: chestY, z: atH() },
            ],
            'lineFigure-collar',
            WEIGHTS.detail,
          ),
        ];
        for (const side of [-1, 1]) {
          marks.push(
            stroke(
              'ink',
              [
                { x: m.cx + side * 0.115 * m.h, y: m.shoulderY + 0.02 * m.h, z: atH() },
                { x: m.cx + side * 0.09 * m.h, y: m.sightY + 0.05, z: atH() },
              ],
              `lineFigure-arm${side}`,
              WEIGHTS.detail,
            ),
          );
        }
        return marks;
      },
    },
    // 7. The ink bust carved: paper strokes over the mass — hairline,
    // collar, shoulder seams — silhouette with readable interior.
    {
      name: 'carvedBust',
      w: 0.34,
      h: 1.62,
      draw: (s) => {
        const m = measures(s);
        const marks: Mark[] = [...bust('ink', m)];
        const hairPts: Pt3[] = [];
        for (let i = 0; i <= 8; i++) {
          const a = Math.PI * (1 - (i / 8) * 1.2);
          hairPts.push({
            x: m.cx + Math.cos(a) * m.hr * 0.62,
            y: m.headY + m.hr * 0.3 - Math.sin(a) * m.hr * 0.62,
            z: atH(),
          });
        }
        marks.push(stroke('paper', hairPts, 'carvedBust-hairline', WEIGHTS.detail));
        marks.push(
          stroke(
            'paper',
            [
              { x: m.cx - 0.1 * m.h, y: m.shoulderY + 0.1 * m.h, z: atH() },
              { x: m.cx, y: m.shoulderY + 0.14 * m.h, z: atH() },
              { x: m.cx + 0.1 * m.h, y: m.shoulderY + 0.1 * m.h, z: atH() },
            ],
            'carvedBust-collar',
            WEIGHTS.detail,
          ),
        );
        for (const side of [-1, 1]) {
          marks.push(
            stroke(
              'paper',
              [
                { x: m.cx + side * 0.11 * m.h, y: m.shoulderY + 0.02 * m.h, z: atH() },
                { x: m.cx + side * 0.1 * m.h, y: m.sightY + 0.05, z: atH() },
              ],
              `carvedBust-seam${side}`,
              WEIGHTS.detail,
            ),
          );
        }
        return marks;
      },
    },
    // 8. The back-lit bust with its lamp halo: the warm ambient wash
    // behind the head and shoulders, the ink mass in front.
    {
      name: 'glowBust',
      w: 0.34,
      h: 1.62,
      draw: (s) => {
        const m = measures(s);
        return [
          mass('ambient', circ(m.cx, m.headY + 0.03 * m.h, m.hr * 2.2, 16)),
          mass('ambient', [
            { x: m.cx - m.shW * 0.75, y: m.shoulderY - 0.05 * m.h, z: atH() },
            { x: m.cx + m.shW * 0.75, y: m.shoulderY - 0.05 * m.h, z: atH() },
            { x: m.cx + m.shW * 0.6, y: m.sightY + 0.1, z: atH() },
            { x: m.cx - m.shW * 0.6, y: m.sightY + 0.1, z: atH() },
          ]),
          ...bust('ink', m),
        ];
      },
    },
    // 9. The figure in the plants' own language: everything circles and
    // tapered ribbons, soft and lopsided, in the furniture gray.
    {
      name: 'softFigure',
      w: 0.32,
      h: 1.62,
      draw: (s) => {
        const m = measures(s);
        const marks: Mark[] = [
          mass('furniture2', circ(m.cx + 0.015 * m.h, m.headY + 0.01 * m.h, m.hr * 1.05)),
          mass(
            'furniture2',
            ribbon(
              { x: m.cx - 0.1 * m.h, y: m.shoulderY - 0.02 * m.h },
              { x: m.cx + 0.02 * m.h, y: (m.shoulderY + m.sightY) / 2 + 0.04 },
              { x: m.cx - 0.02 * m.h, y: m.sightY + 0.1 },
              0.26 * m.h,
              0.24 * m.h,
            ),
          ),
        ];
        for (const side of [-1, 1]) {
          marks.push(
            mass(
              'furniture2',
              ribbon(
                { x: m.cx + side * 0.1 * m.h, y: m.shoulderY },
                { x: m.cx + side * 0.17 * m.h, y: (m.shoulderY + m.sightY) / 2 },
                { x: m.cx + side * 0.13 * m.h, y: m.sightY + 0.06 },
                0.055 * m.h,
                0.04 * m.h,
              ),
            ),
          );
        }
        return marks;
      },
    },
    // 10. Close to the glass: the same ink bust drawn 1.25× larger, its
    // waist at the sightline, shoulders spanning half the pane.
    {
      name: 'waistCrop',
      w: 0.52,
      h: 2.05,
      draw: (s) => {
        const m = measures(s);
        return [
          mass('ink', circ(m.cx, m.headY, m.hr)),
          mass('ink', [
            { x: m.cx - m.shW / 2, y: m.shoulderY, z: atH() },
            { x: m.cx + m.shW / 2, y: m.shoulderY, z: atH() },
            { x: m.cx + m.hipW / 2, y: m.sightY + 0.1, z: atH() },
            { x: m.cx - m.hipW / 2, y: m.sightY + 0.1, z: atH() },
          ]),
        ];
      },
    },
  ];

  const KINDS_SHEET_COLS = 3;
  const STRIP_COLS = 5;

  function fit(box: { width: number; height: number; dpr: number }, cols: number, rows: number) {
    const scale = Math.min(box.width / (cols * UNIT_PITCH_X), box.height / (rows * UNIT_PITCH_Y));
    return { scale: box.dpr * scale, cx: (box.width * box.dpr) / 2, cy: (box.height * box.dpr) / 2 };
  }

  function plateOrigin(g: ReturnType<typeof fit>, i: number, cols: number, rows: number) {
    const ox = ((i % cols) - (cols - 1) / 2) * UNIT_PITCH_X;
    const oy = (Math.floor(i / cols) - (rows - 1) / 2) * UNIT_PITCH_Y;
    return { ox, oy };
  }

  function pointerEye(): (canvas: HTMLCanvasElement) => { x: number; y: number } {
    const pointer = { x: 0, y: 0 };
    window.addEventListener('pointermove', (e) => {
      pointer.x = e.clientX / window.innerWidth - 0.5;
      pointer.y = e.clientY / window.innerHeight - 0.5;
    });
    return () => ({ ...pointer });
  }

  const labelFont = `${getComputedStyle(document.body).getPropertyValue('--typography-body2-fontFamily').trim() || 'sans-serif'}`;

  // One window scene per style: shell, lamp pinned to the side, the
  // human centred on its depth, sill. No curtain — a rolled curtain would
  // cover the figure it is meant to sit behind.
  function humanPlate(c: Candidate, seed: number, i: number, theme: Theme, time: number, ctx: CanvasRenderingContext2D): void {
    const pen = new Pen({ ...DEFAULT_TUNING }, windowSeed(seed, i, 0));
    pen.setTime(time);
    const plan = expandShell(pen.seed);
    const opening = innerRect(plan.faceWidth);
    const rng = fork(pen.seed, 'dna');
    const sill = sillMarks(rng, opening);
    const lamp = pinnedLamp({ location: i % 2 === 0 ? 'innerRight' : 'innerLeft' });
    const room = roomOf(opening);
    const cx = (opening.left + opening.right) / 2;
    const x0 = cx - c.w / 2;
    const spot: Spot = { x0, x1: x0 + c.w, floorY: room.bottom, topY: room.bottom - c.h, w: c.w, h: c.h };
    execute(
      [
        ...shellMarks(plan),
        ...lampMarks(lamp, opening, theme.isNight),
        ...c.draw(spot),
        ...sill,
      ],
      pen,
      ctx,
      windowPalette(pen.seed, theme),
      makeProjection({ x: 0, y: 0 }),
      opening,
    );
  }

  function mountKinds(canvas: HTMLCanvasElement, label: HTMLSpanElement, button: HTMLButtonElement): void {
    let seed = rollSeed();
    const show = () => (label.textContent = `seed ${seed}`);
    show();
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme) => {
        const box = cssBox(canvas);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        // ?kind=<name> collapses the sheet to one huge plate — the close
        // look without a screenshot slicer.
        const one = new URLSearchParams(window.location.search).get('kind');
        const shown = CANDIDATES.filter((c) => !one || c.name === one);
        const cols = one ? shown.length : KINDS_SHEET_COLS;
        const rws = Math.ceil(shown.length / cols);
        const g = fit(box, cols, rws);
        ctx.setTransform(g.scale, 0, 0, g.scale, g.cx, g.cy);
        shown.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, cols, rws);
          ctx.save();
          ctx.translate(ox, oy);
          humanPlate(c, seed, i, theme, time, ctx);
          ctx.restore();
        });
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.ink;
        ctx.globalAlpha = 0.75;
        ctx.font = `${Math.max(10, 0.16 * g.scale)}px ${labelFont}`;
        ctx.textAlign = 'center';
        shown.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, cols, rws);
          ctx.fillText(c.name, g.cx + ox * g.scale, g.cy + oy * g.scale + 0.82 * g.scale);
        });
        ctx.globalAlpha = 1;
      },
      pointerEye(),
    );
    button.addEventListener('click', () => {
      seed = rollSeed();
      show();
    });
  }

  function mountStrip(canvas: HTMLCanvasElement): void {
    createDemoLoop(
      canvas,
      (ctx, time, theme: Theme) => {
        const box = cssBox(canvas);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.paper;
        ctx.fillRect(0, 0, box.width * box.dpr, box.height * box.dpr);
        const rows = Math.ceil(CANDIDATES.length / STRIP_COLS);
        const g = fit(box, STRIP_COLS, rows);
        ctx.setTransform(g.scale, 0, 0, g.scale, g.cx, g.cy);
        CANDIDATES.forEach((c, i) => {
          const { ox, oy } = plateOrigin(g, i, STRIP_COLS, rows);
          ctx.save();
          ctx.translate(ox, oy);
          humanPlate(c, 424242, i, theme, time, ctx);
          ctx.restore();
        });
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = theme.ink;
        ctx.globalAlpha = 0.75;
        ctx.font = `${Math.max(9, 0.14 * g.scale)}px ${labelFont}`;
        ctx.textAlign = 'center';
        CANDIDATES.forEach((c, i) => {
          const { ox } = plateOrigin(g, i, STRIP_COLS, rows);
          ctx.fillText(c.name, g.cx + ox * g.scale, g.cy + 1.02 * g.scale);
        });
        ctx.globalAlpha = 1;
      },
      pointerEye(),
    );
  }

  const el = (id: string) => document.getElementById(id)!;
  mountKinds(el('kinds') as HTMLCanvasElement, el('kinds-seed'), el('kinds-reseed') as HTMLButtonElement);
  mountStrip(el('strip') as HTMLCanvasElement);
</script>
