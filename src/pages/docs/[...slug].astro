---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/components/layouts/BaseLayout.astro';
import ChapterLayout from '@/components/docs/ChapterLayout.astro';
import type { ChapterItem, ChapterLayoutProps, TocHeading } from '@/components/docs/types';
import { chapterNumber, chapterSlug } from '@/lib/chapters';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  return chapters.map((chapter) => ({
    params: { slug: chapterSlug(chapter.id) },
    props: { chapter },
  }));
}

const { chapter } = Astro.props;
const { Content, headings } = await render(chapter);

const all = (await getCollection('chapters')).toSorted(
  (a, b) => chapterNumber(a.id) - chapterNumber(b.id),
);
const items: ChapterItem[] = all.map((c) => ({
  slug: chapterSlug(c.id),
  number: chapterNumber(c.id),
  title: c.data.title,
  status: c.data.status,
}));
const index = items.findIndex((i) => i.slug === chapterSlug(chapter.id));
const current = items[index];
if (!current) throw new Error(`docs page: chapter "${chapter.id}" not in collection`);

const depths = [...new Set(headings.map((h) => h.depth))].sort((a, b) => a - b);
const props: ChapterLayoutProps = {
  chapters: items,
  chapter: current,
  headings: headings.map((h) => ({
    slug: h.slug,
    text: h.text,
    depth: depths.indexOf(h.depth),
  })),
  prev: index > 0 ? items[index - 1] : undefined,
  next: index < items.length - 1 ? items[index + 1] : undefined,
};
---

<BaseLayout title={chapter.data.title} wide>
  <ChapterLayout {...props}>
    <Content />
  </ChapterLayout>
</BaseLayout>

<style is:global>
  .ChapterProse h1,
  .ChapterProse h2 {
    font-family: var(--typography-h4-fontFamily);
    font-weight: var(--typography-h4-fontWeight);
    font-size: var(--typography-h4-fontSize);
    line-height: var(--typography-h4-lineHeight);
    padding-top: var(--spacing-component);
    padding-bottom: var(--spacing-paragraph);
  }

  .ChapterProse h3,
  .ChapterProse h4,
  .ChapterProse h5,
  .ChapterProse h6 {
    font-family: var(--typography-h5-fontFamily);
    font-weight: var(--typography-h5-fontWeight);
    font-size: var(--typography-h5-fontSize);
    line-height: var(--typography-h5-lineHeight);
    padding-top: var(--spacing-component);
    padding-bottom: var(--spacing-paragraph);
  }

  .ChapterProse p,
  .ChapterProse ul,
  .ChapterProse ol {
    font-family: var(--typography-body1-fontFamily);
    font-weight: var(--typography-body1-fontWeight);
    font-size: var(--typography-body1-fontSize);
    line-height: var(--typography-body1-lineHeight);
    padding-bottom: var(--spacing-paragraph);
  }

  .ChapterProse ul,
  .ChapterProse ol {
    padding-left: 1.5rem;
    list-style: initial;
  }

  .ChapterProse ol {
    list-style: decimal;
  }

  .ChapterProse code {
    font-family: var(--typography-code-fontFamily);
    font-weight: var(--typography-code-fontWeight);
    font-size: var(--typography-code-fontSize);
    line-height: var(--typography-code-lineHeight);
  }

  .ChapterProse :not(pre) > code {
    background-color: rgb(var(--color-accent-foreground) / 25%);
    border: var(--border-secondary);
    border-radius: var(--size-border-radius);
    padding: 0 0.5rem;
  }

  .ChapterProse pre {
    background-color: rgb(var(--color-accent-foreground) / 7%);
    border: var(--border);
    border-radius: var(--size-border-radius);
    padding: var(--spacing-paragraph);
    overflow-x: auto;
    margin-bottom: var(--spacing-paragraph);
  }

  .ChapterProse blockquote {
    border-left: var(--border);
    padding-left: var(--spacing-paragraph);
    color: rgb(var(--color-secondary-foreground));
  }
</style>
